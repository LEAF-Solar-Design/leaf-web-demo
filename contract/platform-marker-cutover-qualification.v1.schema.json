{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://leafdesign.ai/contracts/platform-marker-cutover-qualification.v1.schema.json",
  "title": "Dormant platform marker cutover qualification evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "source", "posture", "scheduled_anchor", "shadows"],
  "properties": {
    "schema": {"const": "leaf.platform-marker-cutover-qualification.v1"},
    "source": {"$ref": "#/$defs/source"},
    "posture": {"$ref": "#/$defs/posture"},
    "scheduled_anchor": {"$ref": "#/$defs/scheduledAnchor"},
    "shadows": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "items": {"$ref": "#/$defs/shadow"}
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]{0,199}$"},
    "sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?(?:Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_commit", "source_tree", "deploy_workflow_blob", "restore_workflow_blob",
        "ledger_script_blob", "legacy_census_script_blob", "migration_horizon_sha256",
        "ledger_generation_sha256", "writer_lock_generation_sha256", "captured_at"
      ],
      "properties": {
        "source_commit": {"$ref": "#/$defs/sha"},
        "source_tree": {"$ref": "#/$defs/sha"},
        "deploy_workflow_blob": {"$ref": "#/$defs/sha"},
        "restore_workflow_blob": {"$ref": "#/$defs/sha"},
        "ledger_script_blob": {"$ref": "#/$defs/sha"},
        "legacy_census_script_blob": {"$ref": "#/$defs/sha"},
        "migration_horizon_sha256": {"$ref": "#/$defs/digest"},
        "ledger_generation_sha256": {"$ref": "#/$defs/digest"},
        "writer_lock_generation_sha256": {"$ref": "#/$defs/digest"},
        "captured_at": {"$ref": "#/$defs/timestamp"}
      }
    },
    "posture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["marker_ledger_mode", "digest_aware_reconcile", "active_writers"],
      "properties": {
        "marker_ledger_mode": {"enum": ["disabled", "shadow", "enabled"]},
        "digest_aware_reconcile": {"type": "boolean"},
        "active_writers": {"type": "integer", "minimum": 0}
      }
    },
    "checkpointContent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema", "source_commit", "source_tree", "deploy_workflow_blob",
        "restore_workflow_blob", "ledger_script_blob", "legacy_census_script_blob",
        "migration_horizon_sha256", "scan_started_at", "scan_completed_at",
        "result", "open_count", "open_set_sha256"
      ],
      "properties": {
        "schema": {"const": "leaf.staging-marker-checkpoint-anchor.v1"},
        "source_commit": {"$ref": "#/$defs/sha"},
        "source_tree": {"$ref": "#/$defs/sha"},
        "deploy_workflow_blob": {"$ref": "#/$defs/sha"},
        "restore_workflow_blob": {"$ref": "#/$defs/sha"},
        "ledger_script_blob": {"$ref": "#/$defs/sha"},
        "legacy_census_script_blob": {"$ref": "#/$defs/sha"},
        "migration_horizon_sha256": {"$ref": "#/$defs/digest"},
        "scan_started_at": {"$ref": "#/$defs/timestamp"},
        "scan_completed_at": {"$ref": "#/$defs/timestamp"},
        "result": {"enum": ["EMPTY", "OPEN"]},
        "open_count": {"type": "integer", "minimum": 0},
        "open_set_sha256": {"$ref": "#/$defs/hash"}
      },
      "allOf": [
        {"if": {"properties": {"result": {"const": "EMPTY"}}}, "then": {"properties": {"open_count": {"const": 0}}}},
        {"if": {"properties": {"result": {"const": "OPEN"}}}, "then": {"properties": {"open_count": {"minimum": 1}}}}
      ]
    },
    "checkpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256", "content"],
      "properties": {
        "sha256": {"$ref": "#/$defs/digest"},
        "content": {"$ref": "#/$defs/checkpointContent"}
      }
    },
    "fullScan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "checkpoint", "workflow_blob", "result", "open_count", "open_set_sha256", "duration_seconds"],
      "properties": {
        "schema": {"const": "leaf.legacy-marker-census.v1"},
        "checkpoint": {"$ref": "#/$defs/checkpoint"},
        "workflow_blob": {"$ref": "#/$defs/sha"},
        "result": {"enum": ["EMPTY", "OPEN"]},
        "open_count": {"type": "integer", "minimum": 0},
        "open_set_sha256": {"$ref": "#/$defs/hash"},
        "duration_seconds": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "indexed": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": [
        "schema", "checkpoint_sha256", "result", "open_count", "open_set_sha256",
        "duration_seconds", "lock_acquired_at", "bounded_delta_seconds",
        "strong_consistent", "writer_lock_held", "ledger_union_delta_exact",
        "pre_post_snapshot_stable", "fallback_to_full_scan_on_error"
      ],
      "properties": {
        "schema": {"const": "leaf.staging-marker-ledger-census.v1"},
        "checkpoint_sha256": {"$ref": "#/$defs/digest"},
        "result": {"enum": ["EMPTY", "OPEN"]},
        "open_count": {"type": "integer", "minimum": 0},
        "open_set_sha256": {"$ref": "#/$defs/hash"},
        "duration_seconds": {"type": "number", "exclusiveMinimum": 0},
        "lock_acquired_at": {"$ref": "#/$defs/timestamp"},
        "bounded_delta_seconds": {"type": "number", "exclusiveMinimum": 0, "maximum": 86400},
        "strong_consistent": {"const": true},
        "writer_lock_held": {"const": true},
        "ledger_union_delta_exact": {"const": true},
        "pre_post_snapshot_stable": {"const": true},
        "fallback_to_full_scan_on_error": {"const": true}
      }
    },
    "shadow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "transaction_id", "terminal_receipt_sha256", "scenario", "source_evidence_sha256",
        "terminal", "active_writers", "completed_at", "checkpoint_state",
        "observed_checkpoint_sha256", "full_scan", "indexed", "replacement_blocks",
        "integrity_alarm", "fallback_to_full_scan"
      ],
      "properties": {
        "transaction_id": {"$ref": "#/$defs/id"},
        "terminal_receipt_sha256": {"$ref": "#/$defs/digest"},
        "scenario": {"enum": [
          "normal_success", "forced_cancellation", "missing_artifact",
          "failed_settlement", "expired_lease", "planted_open_row",
          "artifact_without_ledger", "stale_or_missing_checkpoint"
        ]},
        "source_evidence_sha256": {"$ref": "#/$defs/digest"},
        "terminal": {"type": "boolean"},
        "active_writers": {"type": "integer", "minimum": 0},
        "completed_at": {"$ref": "#/$defs/timestamp"},
        "checkpoint_state": {"enum": ["current", "stale", "missing"]},
        "observed_checkpoint_sha256": {"anyOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]},
        "full_scan": {"$ref": "#/$defs/fullScan"},
        "indexed": {"$ref": "#/$defs/indexed"},
        "replacement_blocks": {"type": "boolean"},
        "integrity_alarm": {"type": "boolean"},
        "fallback_to_full_scan": {"type": "boolean"}
      }
    },
    "scheduledAnchor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "terminal", "maximum_age_seconds", "terminal_receipt_sha256", "full_scan"],
      "properties": {
        "enabled": {"type": "boolean"},
        "terminal": {"const": true},
        "maximum_age_seconds": {"type": "number", "exclusiveMinimum": 0, "maximum": 604800},
        "terminal_receipt_sha256": {"$ref": "#/$defs/digest"},
        "full_scan": {"$ref": "#/$defs/fullScan"}
      }
    }
  }
}
