{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://leafdesign.ai/contracts/platform-proof-reuse.v3.schema.json",
  "title": "Leaf platform semantic proof reuse",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "state", "decision", "reason_code", "admitted_lineage_digest",
    "prior_receipt_digest", "deployment_identity_digest",
    "current_token_digest", "admitted_token_digest", "release_scope_digest",
    "workspace_profile_count", "reuse_attachment_digest",
    "selector_activation_authorized", "proof_execution_authorized"
  ],
  "properties": {
    "schema": {"const": "leaf.platform-proof-reuse.v3"},
    "state": {"const": "SHADOW"},
    "decision": {"enum": ["reuse", "fresh_proof"]},
    "reason_code": {
      "enum": [
        "proof_reuse_exact", "prior_not_terminal_green", "verifier_not_green",
        "rollback_not_green", "product_mutation_not_clean",
        "receipt_binding_mismatch", "lineage_incomplete",
        "source_impact_not_nil", "current_lineage_mismatch",
        "admitted_lineage_mismatch", "token_continuity_mismatch"
      ]
    },
    "admitted_lineage_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "prior_receipt_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "deployment_identity_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "current_token_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "admitted_token_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "release_scope_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "workspace_profile_count": {"const": 4},
    "reuse_attachment_digest": {
      "oneOf": [
        {"type": "null"},
        {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      ]
    },
    "selector_activation_authorized": {"const": false},
    "proof_execution_authorized": {"const": false}
  }
}
