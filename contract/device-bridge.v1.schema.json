{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://leafautomation.ai/contract/device-bridge.v1.schema.json",
  "title": "leaf.device-bridge.v1",
  "description": "Shared device bridge payload definitions. Validate a message against its named $defs entry.",
  "$defs": {
    "Command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command_id", "op", "args", "issued_at", "expires_at"],
      "properties": {
        "command_id": {"type": "string", "format": "uuid"},
        "op": {"enum": ["pkg.install", "pkg.upgrade", "pkg.uninstall", "pkg.health", "http.proxy", "ha.onboard", "ha.flow.start", "ha.flow.step", "ha.flow.list", "agent.pause", "agent.update"]},
        "args": {"type": "object", "additionalProperties": false, "patternProperties": {"^.+$": {"$ref": "#/$defs/JsonValue"}}},
        "issued_at": {"type": "string", "format": "date-time"},
        "expires_at": {"type": "string", "format": "date-time"}
      },
      "oneOf": [
        {
          "properties": {
            "op": {"const": "pkg.install"},
            "args": {
              "type": "object", "additionalProperties": false, "required": ["package", "version"],
              "properties": {"package": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"}, "version": {"type": "string", "minLength": 1, "maxLength": 128}}
            }
          }
        },
        {
          "properties": {
            "op": {"const": "pkg.upgrade"},
            "args": {
              "type": "object", "additionalProperties": false, "required": ["package", "version"],
              "properties": {"package": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"}, "version": {"type": "string", "minLength": 1, "maxLength": 128}}
            }
          }
        },
        {
          "properties": {
            "op": {"const": "pkg.uninstall"},
            "args": {
              "type": "object", "additionalProperties": false, "required": ["package", "keep_data"],
              "properties": {"package": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"}, "keep_data": {"type": "boolean"}}
            }
          }
        },
        {
          "properties": {
            "op": {"const": "pkg.health"},
            "args": {
              "type": "object", "additionalProperties": false, "required": ["package"],
              "properties": {"package": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"}}
            }
          }
        },
        {
          "properties": {
            "op": {"const": "http.proxy"},
            "args": {
              "type": "object", "additionalProperties": false, "required": ["package", "method", "path"],
              "properties": {
                "package": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"},
                "method": {"enum": ["GET", "POST", "PUT", "PATCH", "DELETE"]},
                "path": {"type": "string", "maxLength": 2048, "pattern": "^/(?!/)[^?#\\\\\\s]*$"},
                "query": {"type": "object", "additionalProperties": false, "patternProperties": {"^.+$": {"type": "string"}}},
                "body_json": {"$ref": "#/$defs/JsonValue"}
              }
            }
          }
        },
        {
          "properties": {
            "op": {"const": "ha.onboard"},
            "args": {"type": "object", "additionalProperties": false, "properties": {}}
          }
        },
        {
          "properties": {
            "op": {"const": "ha.flow.start"},
            "args": {
              "type": "object", "additionalProperties": false, "required": ["handler"],
              "properties": {"handler": {"enum": ["hue", "wiz", "group"]}, "data": {"$ref": "#/$defs/JsonValue", "type": "object", "additionalProperties": false, "patternProperties": {"^[\\s\\S]*$": {"$ref": "#/$defs/JsonValue"}}}}
            }
          }
        },
        {
          "properties": {
            "op": {"const": "ha.flow.step"},
            "args": {
              "type": "object", "additionalProperties": false, "required": ["flow_id", "data"],
              "properties": {"flow_id": {"type": "string", "minLength": 1, "maxLength": 128}, "data": {"$ref": "#/$defs/JsonValue", "type": "object", "additionalProperties": false, "patternProperties": {"^[\\s\\S]*$": {"$ref": "#/$defs/JsonValue"}}}}
            }
          }
        },
        {
          "properties": {
            "op": {"const": "ha.flow.list"},
            "args": {"type": "object", "additionalProperties": false, "properties": {}}
          }
        },
        {
          "properties": {
            "op": {"const": "agent.pause"},
            "args": {"type": "object", "additionalProperties": false, "properties": {}}
          }
        },
        {
          "properties": {
            "op": {"const": "agent.update"},
            "args": {
              "type": "object", "additionalProperties": false, "required": ["version", "sha256"],
              "properties": {"version": {"type": "string", "minLength": 1, "maxLength": 128}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
            }
          }
        }
      ]
    },
    "Result": {
      "type": "object", "additionalProperties": false,
      "required": ["command_id", "status", "finished_at"],
      "properties": {
        "command_id": {"type": "string", "format": "uuid"},
        "status": {"enum": ["ok", "error", "refused"]},
        "finished_at": {"type": "string", "format": "date-time"},
        "data": {"$ref": "#/$defs/JsonValue"},
        "error": {
          "type": "object", "additionalProperties": false, "required": ["code", "message"],
          "properties": {
            "code": {"enum": ["unsupported_op", "package_unknown", "path_denied", "paused", "upstream_error", "timeout", "install_failed", "command_expired", "invalid_args", "version_unknown"]},
            "message": {"type": "string", "minLength": 1, "maxLength": 1024}
          }
        }
      },
      "if": {"properties": {"status": {"const": "ok"}}},
      "then": {"not": {"required": ["error"]}},
      "else": {"required": ["error"]}
    },
    "PackageCatalogEntry": {
      "type": "object", "additionalProperties": false,
      "required": ["package", "display_name", "version", "port", "health_path", "relay_allow"],
      "properties": {
        "package": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"},
        "display_name": {"type": "string", "minLength": 1, "maxLength": 128},
        "version": {"type": "string", "minLength": 1, "maxLength": 128},
        "port": {"type": "integer", "minimum": 1, "maximum": 65535},
        "health_path": {"type": "string", "maxLength": 2048, "pattern": "^/(?!/)[^?#\\\\\\s]*$"},
        "relay_allow": {
          "type": "array", "maxItems": 64, "uniqueItems": true,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["method", "path_prefix"],
            "properties": {"method": {"enum": ["GET", "POST", "PUT", "PATCH", "DELETE"]}, "path_prefix": {"type": "string", "maxLength": 2048, "pattern": "^/(?!/)[^?#\\\\\\s]*$"}}
          }
        }
      }
    },
    "DeviceView": {
      "type": "object", "additionalProperties": false,
      "required": ["device_id", "project_id", "label", "hostname", "platform", "agent_version", "packages", "status", "enrolled_at", "last_seen_at", "revoked_at"],
      "properties": {
        "device_id": {"type": "string", "format": "uuid"},
        "project_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "label": {"type": "string", "minLength": 1, "maxLength": 128},
        "hostname": {"type": "string", "minLength": 1, "maxLength": 253},
        "platform": {
          "type": "object", "additionalProperties": false, "required": ["os", "os_version", "arch"],
          "properties": {"os": {"type": "string", "minLength": 1, "maxLength": 64}, "os_version": {"type": "string", "minLength": 1, "maxLength": 128}, "arch": {"type": "string", "minLength": 1, "maxLength": 64}}
        },
        "agent_version": {"type": "string", "minLength": 1, "maxLength": 128},
        "packages": {"type": "array", "maxItems": 64, "items": {"$ref": "#/$defs/PackageState"}},
        "status": {"enum": ["online", "offline", "paused", "revoked"]},
        "enrolled_at": {"type": "string", "format": "date-time"},
        "last_seen_at": {"type": ["string", "null"], "format": "date-time"},
        "revoked_at": {"type": ["string", "null"], "format": "date-time"}
      }
    },
    "PackageState": {
      "type": "object", "additionalProperties": false,
      "required": ["package", "version", "status", "last_health_at"],
      "properties": {
        "package": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"},
        "version": {"type": "string", "minLength": 1, "maxLength": 128},
        "status": {"enum": ["installed", "running", "stopped", "error"]},
        "last_health_at": {"type": ["string", "null"], "format": "date-time"}
      }
    },
    "AuditEvent": {
      "type": "object", "additionalProperties": false,
      "required": ["at", "actor", "op", "target", "status"],
      "properties": {
        "at": {"type": "string", "format": "date-time"},
        "actor": {"type": "string", "pattern": "^(user:[^\\s]+|device|relay:[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$"},
        "op": {"type": "string", "minLength": 1, "maxLength": 128},
        "target": {"type": "string", "minLength": 1, "maxLength": 256},
        "status": {"enum": ["ok", "error", "refused"]},
        "request_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "EnrollmentResponse": {
      "type": "object", "additionalProperties": false,
      "required": ["enrollment_id", "token", "expires_at", "install_command"],
      "properties": {
        "enrollment_id": {"type": "string", "format": "uuid"},
        "token": {"type": "string", "pattern": "^[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048]$"},
        "expires_at": {"type": "string", "format": "date-time"},
        "install_command": {"type": "string", "minLength": 1, "maxLength": 4096}
      }
    },
    "RelayTokenResponse": {
      "type": "object", "additionalProperties": false,
      "required": ["relay_token", "relay_origin", "path_prefix"],
      "properties": {
        "relay_token": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}\\.[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048]$"},
        "relay_origin": {"type": "string", "format": "uri", "pattern": "^https://[A-Za-z0-9.-]+(:[0-9]{1,5})?$"},
        "path_prefix": {"type": "string", "pattern": "^/api/device-relay/[a-z][a-z0-9-]{0,63}$"}
      }
    },
    "RegisterRequest": {
      "type": "object", "additionalProperties": false,
      "required": ["token", "public_key", "agent_version", "platform", "hostname"],
      "properties": {
        "token": {"type": "string", "pattern": "^[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048]$"},
        "public_key": {"type": "string", "pattern": "^[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048]$"},
        "agent_version": {"type": "string", "minLength": 1, "maxLength": 128},
        "platform": {
          "type": "object", "additionalProperties": false, "required": ["os", "os_version", "arch"],
          "properties": {"os": {"type": "string", "minLength": 1, "maxLength": 64}, "os_version": {"type": "string", "minLength": 1, "maxLength": 128}, "arch": {"type": "string", "minLength": 1, "maxLength": 64}}
        },
        "hostname": {"type": "string", "minLength": 1, "maxLength": 253}
      }
    },
    "PollResponse": {
      "type": "object", "additionalProperties": false, "required": ["commands"],
      "properties": {"commands": {"type": "array", "maxItems": 8, "items": {"$ref": "#/$defs/Command"}}}
    },
    "ResultsRequest": {
      "type": "object", "additionalProperties": false, "required": ["results"],
      "properties": {"results": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"$ref": "#/$defs/Result"}}}
    },
    "HeartbeatRequest": {
      "type": "object", "additionalProperties": false,
      "required": ["agent_version", "packages", "free_mem_mb", "uptime_s"],
      "properties": {
        "agent_version": {"type": "string", "minLength": 1, "maxLength": 128},
        "packages": {"type": "array", "maxItems": 64, "items": {"$ref": "#/$defs/PackageState"}},
        "free_mem_mb": {"type": "integer", "minimum": 0},
        "uptime_s": {"type": "integer", "minimum": 0}
      }
    },
    "JsonValue": {
      "description": "Opaque JSON data only; dynamic keys use patternProperties while wire envelopes remain closed.",
      "oneOf": [
        {"type": ["string", "number", "boolean", "null"]},
        {"type": "array", "items": {"$ref": "#/$defs/JsonValue"}},
        {"type": "object", "additionalProperties": false, "patternProperties": {"^[\\s\\S]*$": {"$ref": "#/$defs/JsonValue"}}}
      ]
    }
  }
}
