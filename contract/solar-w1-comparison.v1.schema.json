  "$defs": {
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fixture_sha256",
        "input_sha256",
        "output_sha256",
        "revision",
        "versions",
        "parameters",
        "units",
        "frame",
        "entity_mapping",
        "before",
        "after",
        "changes",
        "warnings",
        "rejected_inputs",
        "synthetic_fields",
        "fallback_fields",
        "provenance",
        "elapsed_ms",
        "execution_mode",
        "state",
        "survived_reopen",
        "synthetic_flagged"
      ],
      "properties": {
        "fixture_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "input_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "output_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16384
        },
        "versions": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schema",
            "producer",
            "capability",
            "engine",
            "catalog",
            "solver"
          ],
          "properties": {
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 16384
            },
            "producer": {
              "type": "string",
              "minLength": 1,
              "maxLength": 16384
            },
            "capability": {
              "type": "string",
              "minLength": 1,
              "maxLength": 16384
            },
            "engine": {
              "type": "string",
              "minLength": 1,
              "maxLength": 16384
            },
            "catalog": {
              "type": "string",
              "minLength": 1,
              "maxLength": 16384
            },
            "solver": {
              "type": "string",
              "minLength": 1,
              "maxLength": 16384
            }
          }
        },
        "parameters": {
          "type": "object"
        },
        "units": {
          "enum": [
            "mm",
            "cm",
            "m",
            "in",
            "ft"
          ]
        },
        "frame": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "coordinate_system",
            "transform",
            "elevation_datum",
            "crs"
          ],
          "properties": {
            "coordinate_system": {
              "type": "string",
              "minLength": 1,
              "maxLength": 16384
            },
            "transform": {
              "type": "array",
              "minItems": 16,
              "maxItems": 16,
              "items": {
                "type": "number"
              }
            },
            "elevation_datum": {
              "type": "string",
              "minLength": 1,
              "maxLength": 16384
            },
            "crs": {
              "type": "string",
              "minLength": 1,
              "maxLength": 16384
            }
          }
        },
        "entity_mapping": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1,
            "maxLength": 16384
          }
        },
        "before": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "$ref": "#/$defs/value"
          }
        },
        "after": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "$ref": "#/$defs/value"
          }
        },
        "changes": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "created",
            "modified",
            "deleted"
          ],
          "properties": {
            "created": {
              "type": "array",
              "maxItems": 100000,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 16384
              },
              "uniqueItems": true
            },
            "modified": {
              "type": "array",
              "maxItems": 100000,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 16384
              },
              "uniqueItems": true
            },
            "deleted": {
              "type": "array",
              "maxItems": 100000,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 16384
              },
              "uniqueItems": true
            }
          }
        },
        "warnings": {
          "type": "array",
          "maxItems": 100000,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 16384
          }
        },
        "rejected_inputs": {
          "type": "array",
          "maxItems": 100000,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 16384
          }
        },
        "synthetic_fields": {
          "type": "array",
          "maxItems": 100000,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 16384
          }
        },
        "fallback_fields": {
          "type": "array",
          "maxItems": 100000,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 16384
          }
        },
        "provenance": {
          "type": "object",
          "minProperties": 1
        },
        "elapsed_ms": {
          "type": "number",
          "minimum": 0,
          "maximum": 1e+100
        },
        "execution_mode": {
          "enum": [
            "live",
            "recorded",
            "synthetic",
            "fallback"
          ]
        },
        "state": {
          "enum": [
            "committed",
            "pending",
            "failed"
          ]
        },
        "survived_reopen": {
          "type": "boolean"
        },
        "synthetic_flagged": {
          "type": "boolean"
        }
      }
    },
    "entity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entity_id"
      ],
      "properties": {
        "entity_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16384
        }
      }
    },
    "quantity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "value",
        "unit"
      ],
      "properties": {
        "kind": {
          "enum": [
            "coordinate",
            "length",
            "angle",
            "float"
          ]
        },
        "unit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16384
        },
        "value": {
          "oneOf": [
            {
              "type": "number"
            },
            {
              "type": "array",
              "minItems": 2,
              "maxItems": 3,
              "items": {
                "type": "number"
              }
            }
          ]
        }
      }
    },
    "value": {
      "oneOf": [
        {
          "type": [
            "null",
            "boolean",
            "string",
            "number"
          ]
        },
        {
          "type": "array",
          "maxItems": 100000,
          "items": {
            "$ref": "#/$defs/value"
          }
        },
        {
          "$ref": "#/$defs/entity"
        },
        {
          "$ref": "#/$defs/quantity"
        },
        {
          "type": "object",
          "not": {
            "anyOf": [
              {
                "required": [
                  "entity_id"
                ]
              },
              {
                "required": [
                  "kind"
                ]
              }
            ]
          },
          "additionalProperties": {
            "$ref": "#/$defs/value"
          }
        }
      ]
    },
    "comparator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "verdict",
        "diffs"
      ],
      "properties": {
        "name": {
          "const": "solar-w1-semantic"
        },
        "version": {
          "const": "1"
        },
        "verdict": {
          "enum": [
            "pass",
            "fail"
          ]
        },
        "diffs": {
          "type": "array",
          "maxItems": 200,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 16384
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "verdict": {
                "const": "pass"
              }
            }
          },
          "then": {
            "properties": {
              "diffs": {
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "verdict": {
                "const": "fail"
              }
            }
          },
          "then": {
            "properties": {
              "diffs": {
                "minItems": 1
              }
            }
          }
        }
      ]
    }
  }
}
