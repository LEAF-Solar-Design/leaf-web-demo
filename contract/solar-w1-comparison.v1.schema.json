        "terrain",
        "shade",
        "solve",
        "autofill",
        "reoptimization",
        "schedules",
        "bom",
        "exports"
      ]
    },
    "plugin": {
      "$ref": "#/$defs/evidence"
    },
    "studio": {
      "$ref": "#/$defs/evidence"
    },
    "objective_bound": {
      "type": "number",
      "minimum": 0,
      "maximum": 1e+100,
      "description": "Frozen absolute bound in parameters.objective_unit. Only objective and chosen_candidate may vary."
    },
    "prerequisites": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "$ref": "#"
      }
    }
  },
