{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://leafdesign.ai/contract/solar-w1-comparison.v1.schema.json",
  "title": "Solar W1 semantic comparison evidence",
  "description": "Evidence adapter for the Solar parity program. Producers sanitize private payloads. output_sha256 hashes canonical after JSON (sorted keys, compact separators, UTF-8). Input hashes identify the same immutable input. Frames compare exactly. Entity mappings are injective and references explicit. Arrays are ordered. Untagged fields compare exactly. Coordinates and lengths use 1 mm, angles 0.01 degree, declared floats max(1e-6 declared units, 1e-8 magnitude). Safety, constraints, choices, validity and rounding remain exact. The explicit version label none means inapplicable. Runtime validation additionally enforces bounded depth, reference integrity, hashes and family record fields.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "capability",
    "family",
    "plugin",
    "studio"
  ],
  "properties": {
    "schema": {
      "const": "leaf.solar-w1-comparison.v1"
    },
    "capability": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
