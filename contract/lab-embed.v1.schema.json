{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://leaf.internal/contract/lab-embed.v1.schema.json",
  "title": "Lab host messages",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "channel", "version", "kind", "principal_proof", "source_sha", "proposal_revision", "proposal_hash", "sequence", "sent_at_ms", "expires_at_ms", "latency_us", "payload"],
  "properties": {
    "schema": {"const": "leaf.lab-embed.v1"},
    "channel": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
    "version": {"const": 1},
    "kind": {"enum": ["shell.ready", "proposal", "signed-request", "source.value"]},
    "principal_proof": {"$ref": "#/$defs/hash"},
    "source_sha": {"$ref": "#/$defs/hash"},
    "proposal_revision": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "proposal_hash": {"$ref": "#/$defs/hash"},
    "sequence": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "sent_at_ms": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "expires_at_ms": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "latency_us": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "payload": {"type": "object"}
  },
  "allOf": [
    {"if": {"properties": {"kind": {"const": "source.value"}}}, "then": {"properties": {"payload": {"type": "object", "additionalProperties": false, "required": ["rows"], "properties": {"rows": {"type": "array", "maxItems": 200, "items": {"type": "object"}}}}}}},
    {"if": {"properties": {"kind": {"const": "signed-request"}}}, "then": {"properties": {"payload": {"type": "object", "additionalProperties": false, "required": ["request_hash", "handoff"], "properties": {"request_hash": {"$ref": "#/$defs/hash"}, "handoff": {"const": "server-sign"}}}}}},
    {"if": {"properties": {"kind": {"enum": ["shell.ready", "proposal"]}}}, "then": {"properties": {"payload": {"type": "object", "additionalProperties": false}}}}
  ],
  "$defs": {"hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
