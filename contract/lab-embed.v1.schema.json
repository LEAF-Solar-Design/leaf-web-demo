{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://leaf.internal/contract/lab-embed.v1.schema.json",
  "title": "Lab host messages",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "channel", "version", "kind", "principal_proof", "source_sha", "proposal_revision", "proposal_hash", "sequence", "sent_at_ms", "expires_at_ms", "latency_us", "payload"],
  "properties": {
    "schema": {"const": "leaf.lab-embed.v1"},
    "channel": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
    "version": {"const": 1},
    "kind": {"enum": ["shell.ready", "proposal", "signed-request", "source.value", "widget.publish-request"]},
    "principal_proof": {"$ref": "#/$defs/hash"},
    "source_sha": {"$ref": "#/$defs/hash"},
    "proposal_revision": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "proposal_hash": {"$ref": "#/$defs/hash"},
    "sequence": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "sent_at_ms": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "expires_at_ms": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "latency_us": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "payload": {"type": "object"}
  },
  "allOf": [
    {"if": {"properties": {"kind": {"const": "widget.publish-request"}}}, "then": {"properties": {"payload": {
      "type": "object", "additionalProperties": false, "required": ["doc", "source", "renderer_version"],
      "properties": {
        "doc": {"type": "object"},
        "source": {
          "type": "object", "additionalProperties": false, "required": ["artifact_id", "revision", "digest"],
          "properties": {
            "artifact_id": {"type": "string", "pattern": "^(?![\\s\\S]*\\n)[a-zA-Z0-9][a-zA-Z0-9_.-]{0,127}$"},
            "revision": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
            "digest": {"type": "string", "pattern": "^(?![\\s\\S]*\\n)[0-9a-f]{64}$"}
          }
        },
        "renderer_version": {"type": "string", "pattern": "^(?![\\s\\S]*\\n)\\d{1,4}\\.\\d{1,4}\\.\\d{1,4}$"}
      }
    }}}},
    {"if": {"properties": {"kind": {"const": "source.value"}}}, "then": {"properties": {"payload": {"type": "object", "additionalProperties": false, "required": ["rows"], "properties": {"rows": {"type": "array", "maxItems": 200, "items": {"type": "object"}}}}}}},
    {"if": {"properties": {"kind": {"const": "signed-request"}}}, "then": {"properties": {"payload": {"type": "object", "additionalProperties": false, "required": ["request_hash", "handoff"], "properties": {"request_hash": {"$ref": "#/$defs/hash"}, "handoff": {"const": "server-sign"}}}}}},
    {"if": {"properties": {"kind": {"const": "shell.ready"}}}, "then": {"properties": {"payload": {"type": "object", "additionalProperties": false, "properties": {"accepted": {"type": "boolean"}, "restored": {"type": "boolean"}}}}}},
    {"if": {"properties": {"kind": {"const": "proposal"}}}, "then": {"properties": {"payload": {"type": "object", "additionalProperties": false, "required": ["document", "ready", "problems"], "properties": {"document": {"$ref": "lab-graph.v1.schema.json"}, "ready": {"type": "boolean"}, "problems": {"type": "array", "maxItems": 64, "items": {"type": "string"}}, "restore": {"type": "boolean"}}}}}}
  ],
  "$defs": {"hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
