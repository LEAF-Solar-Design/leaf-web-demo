{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://leafdesign.ai/contracts/platform-qualification-manifest.v1.schema.json",
  "title": "Leaf platform qualification manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "repository",
    "source_commit",
    "source_tree",
    "services",
    "config_contract_digest",
    "image_aliases",
    "producer",
    "deployment_identity",
    "supported_deployment_path",
    "verifier_version",
    "topology_version",
    "signature",
    "payload_digest"
  ],
  "properties": {
    "schema": {"const": "platform-qualification-manifest.v1"},
    "repository": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
    "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "source_tree": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "services": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {"$ref": "#/$defs/service"}
    },
    "config_contract_digest": {"$ref": "#/$defs/sha256"},
    "image_aliases": {
      "type": "array",
      "items": {"type": "string", "minLength": 1, "maxLength": 256},
      "uniqueItems": true
    },
    "producer": {"$ref": "#/$defs/producer"},
    "deployment_identity": {"$ref": "#/$defs/deploymentIdentity"},
    "supported_deployment_path": {
      "enum": ["adopted_supply", "full_build", "both"]
    },
    "verifier_version": {"type": "string", "pattern": "^v[0-9]+$"},
    "topology_version": {"type": "string", "pattern": "^v[0-9]+$"},
    "signature": {"$ref": "#/$defs/signature"},
    "payload_digest": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "image_digest", "provenance", "entrypoint"],
      "properties": {
        "name": {"enum": ["app", "broker", "canonical-worker", "harness", "web"]},
        "image_digest": {"$ref": "#/$defs/sha256"},
        "provenance": {"enum": ["adopted", "full_build"]},
        "entrypoint": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1, "maxLength": 512}}
      }
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity", "workflow", "run_id", "attempt"],
      "properties": {
        "identity": {"type": "string", "minLength": 1, "maxLength": 200},
        "workflow": {"type": "string", "pattern": "^\\.github/workflows/[A-Za-z0-9_.-]+\\.ya?ml$"},
        "run_id": {"type": "integer", "minimum": 1},
        "attempt": {"type": "integer", "minimum": 1}
      }
    },
    "deploymentIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "value"],
      "properties": {
        "schema": {"const": "leaf.deployment-identity.v1"},
        "value": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "key_id", "signed_payload_digest", "value"],
      "properties": {
        "algorithm": {"const": "external-v1"},
        "key_id": {"type": "string", "minLength": 1, "maxLength": 200},
        "signed_payload_digest": {"$ref": "#/$defs/sha256"},
        "value": {"type": "string", "minLength": 16, "maxLength": 4096}
      }
    }
  }
}
