{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://leafdesign.ai/contracts/platform-gate-pruning-shadow.v1.schema.json",
  "title": "Dormant platform marker gate-pruning shadow evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "gate", "source", "posture", "scheduled_audit", "comparisons", "negative_controls"],
  "properties": {
    "schema": {"const": "leaf.platform-gate-pruning-shadow.v1"},
    "gate": {"$ref": "#/$defs/gate"},
    "source": {"$ref": "#/$defs/source"},
    "posture": {"$ref": "#/$defs/posture"},
    "scheduled_audit": {"$ref": "#/$defs/audit"},
    "comparisons": {"type": "array", "minItems": 6, "maxItems": 6, "items": {"$ref": "#/$defs/comparison"}},
    "negative_controls": {"$ref": "#/$defs/controls"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]{0,199}$"},
    "sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "timestamp": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?(?:Z|[+-][0-9]{2}:[0-9]{2})$"},
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gate_id", "safety_job", "state_machine_stages", "current_control", "proposed_replacement"],
      "properties": {
        "gate_id": {"const": "legacy-marker-census-per-transaction"},
        "safety_job": {"const": "detect-any-transaction-owing-settlement"},
        "state_machine_stages": {"const": ["preflight", "settlement"]},
        "current_control": {"const": "full-62-day-history-census"},
        "proposed_replacement": {"const": "indexed-marker-ledger"}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_commit", "source_tree", "deploy_workflow_blob", "restore_workflow_blob",
        "ledger_script_blob", "legacy_census_script_blob", "migration_horizon_sha256",
        "ledger_generation_sha256", "writer_lock_generation_sha256", "capture_id", "captured_at"
      ],
      "properties": {
        "source_commit": {"$ref": "#/$defs/sha"},
        "source_tree": {"$ref": "#/$defs/sha"},
        "deploy_workflow_blob": {"$ref": "#/$defs/sha"},
        "restore_workflow_blob": {"$ref": "#/$defs/sha"},
        "ledger_script_blob": {"$ref": "#/$defs/sha"},
        "legacy_census_script_blob": {"$ref": "#/$defs/sha"},
        "migration_horizon_sha256": {"$ref": "#/$defs/digest"},
        "ledger_generation_sha256": {"$ref": "#/$defs/digest"},
        "writer_lock_generation_sha256": {"$ref": "#/$defs/digest"},
        "capture_id": {"$ref": "#/$defs/id"},
        "captured_at": {"$ref": "#/$defs/timestamp"}
      }
    },
    "posture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["marker_ledger_mode", "digest_aware_reconcile", "active_writers"],
      "properties": {
        "marker_ledger_mode": {"enum": ["disabled", "shadow", "enabled"]},
        "digest_aware_reconcile": {"type": "boolean"},
        "active_writers": {"type": "integer", "minimum": 0}
      }
    },
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "anchor_type", "checkpoint_sha256", "checkpoint_content", "workflow_blob", "last_completed_at", "maximum_age_seconds", "terminal_receipt_sha256"],
      "properties": {
        "enabled": {"type": "boolean"},
        "anchor_type": {"const": "successful_full_artifact_scan"},
        "checkpoint_sha256": {"$ref": "#/$defs/digest"},
        "checkpoint_content": {"$ref": "#/$defs/checkpointContent"},
        "workflow_blob": {"$ref": "#/$defs/sha"},
        "last_completed_at": {"$ref": "#/$defs/timestamp"},
        "maximum_age_seconds": {"type": "number", "exclusiveMinimum": 0, "maximum": 604800},
        "terminal_receipt_sha256": {"$ref": "#/$defs/digest"}
      }
    },
    "checkpointContent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema", "source_commit", "source_tree", "deploy_workflow_blob",
        "restore_workflow_blob", "ledger_script_blob", "legacy_census_script_blob",
        "migration_horizon_sha256", "scan_started_at", "scan_completed_at",
        "result", "open_count", "open_set_sha256"
      ],
      "properties": {
        "schema": {"const": "leaf.staging-marker-checkpoint-anchor.v1"},
        "source_commit": {"$ref": "#/$defs/sha"},
        "source_tree": {"$ref": "#/$defs/sha"},
        "deploy_workflow_blob": {"$ref": "#/$defs/sha"},
        "restore_workflow_blob": {"$ref": "#/$defs/sha"},
        "ledger_script_blob": {"$ref": "#/$defs/sha"},
        "legacy_census_script_blob": {"$ref": "#/$defs/sha"},
        "migration_horizon_sha256": {"$ref": "#/$defs/digest"},
        "scan_started_at": {"$ref": "#/$defs/timestamp"},
        "scan_completed_at": {"$ref": "#/$defs/timestamp"},
        "result": {"enum": ["EMPTY", "OPEN"]},
        "open_count": {"type": "integer", "minimum": 0},
        "open_set_sha256": {"$ref": "#/$defs/hash"}
      },
      "allOf": [
        {"if": {"properties": {"result": {"const": "EMPTY"}}}, "then": {"properties": {"open_count": {"const": 0}}}},
        {"if": {"properties": {"result": {"const": "OPEN"}}}, "then": {"properties": {"open_count": {"minimum": 1}}}}
      ]
    },
    "legacy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "workflow_blob", "checkpoint_sha256", "result", "open_count", "open_set_sha256", "duration_seconds"],
      "properties": {
        "schema": {"const": "leaf.legacy-marker-census.v1"},
        "workflow_blob": {"$ref": "#/$defs/sha"},
        "checkpoint_sha256": {"$ref": "#/$defs/digest"},
        "result": {"enum": ["EMPTY", "OPEN"]},
        "open_count": {"type": "integer", "minimum": 0},
        "open_set_sha256": {"$ref": "#/$defs/hash"},
        "duration_seconds": {"type": "number", "exclusiveMinimum": 0}
      },
      "allOf": [
        {"if": {"properties": {"result": {"const": "EMPTY"}}}, "then": {"properties": {"open_count": {"const": 0}}}},
        {"if": {"properties": {"result": {"const": "OPEN"}}}, "then": {"properties": {"open_count": {"minimum": 1}}}}
      ]
    },
    "indexedReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema", "result", "strong_consistent", "writer_lock_held",
        "ledger_union_delta_exact", "pre_post_snapshot_stable",
        "fallback_to_full_scan_on_error", "bounded_delta_seconds",
        "lock_acquired_at",
        "open_count", "open_set_sha256"
      ],
      "properties": {
        "schema": {"const": "leaf.staging-marker-ledger-census.v1"},
        "result": {"enum": ["EMPTY", "OPEN"]},
        "strong_consistent": {"const": true},
        "writer_lock_held": {"const": true},
        "ledger_union_delta_exact": {"const": true},
        "pre_post_snapshot_stable": {"const": true},
        "fallback_to_full_scan_on_error": {"const": true},
        "bounded_delta_seconds": {"type": "number", "exclusiveMinimum": 0, "maximum": 86400},
        "lock_acquired_at": {"$ref": "#/$defs/timestamp"},
        "open_count": {"type": "integer", "minimum": 0},
        "open_set_sha256": {"$ref": "#/$defs/hash"}
      },
      "allOf": [
        {"if": {"properties": {"result": {"const": "EMPTY"}}}, "then": {"properties": {"open_count": {"const": 0}}}},
        {"if": {"properties": {"result": {"const": "OPEN"}}}, "then": {"properties": {"open_count": {"minimum": 1}}}}
      ]
    },
    "indexed": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checkpoint_sha256", "duration_seconds", "receipt"],
      "properties": {
        "checkpoint_sha256": {"$ref": "#/$defs/digest"},
        "duration_seconds": {"type": "number", "exclusiveMinimum": 0},
        "receipt": {"$ref": "#/$defs/indexedReceipt"}
      }
    },
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "transaction_id", "source_evidence_sha256", "scenario", "source_commit",
        "deploy_workflow_blob", "migration_horizon_sha256", "ledger_generation_sha256",
        "writer_lock_generation_sha256", "active_writers", "terminal",
        "terminal_receipt_sha256", "completed_at", "checkpoint_content", "legacy", "indexed"
      ],
      "properties": {
        "transaction_id": {"$ref": "#/$defs/id"},
        "source_evidence_sha256": {"$ref": "#/$defs/digest"},
        "scenario": {"enum": ["normal_success", "forced_cancellation", "missing_artifact", "failed_settlement", "expired_lease"]},
        "source_commit": {"$ref": "#/$defs/sha"},
        "deploy_workflow_blob": {"$ref": "#/$defs/sha"},
        "migration_horizon_sha256": {"$ref": "#/$defs/digest"},
        "ledger_generation_sha256": {"$ref": "#/$defs/digest"},
        "writer_lock_generation_sha256": {"$ref": "#/$defs/digest"},
        "active_writers": {"type": "integer", "minimum": 0},
        "terminal": {"type": "boolean"},
        "terminal_receipt_sha256": {"$ref": "#/$defs/digest"},
        "completed_at": {"$ref": "#/$defs/timestamp"},
        "checkpoint_content": {"$ref": "#/$defs/checkpointContent"},
        "legacy": {"$ref": "#/$defs/legacy"},
        "indexed": {"$ref": "#/$defs/indexed"}
      }
    },
    "control": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scenario", "transaction_id", "source_evidence_sha256", "source_commit",
        "deploy_workflow_blob", "migration_horizon_sha256", "ledger_generation_sha256",
        "writer_lock_generation_sha256", "active_writers", "terminal",
        "terminal_receipt_sha256", "completed_at", "replacement_blocks",
        "integrity_alarm", "checkpoint_content", "legacy", "indexed"
      ],
      "properties": {
        "scenario": {"enum": ["planted_open_row", "artifact_without_ledger"]},
        "transaction_id": {"$ref": "#/$defs/id"},
        "source_evidence_sha256": {"$ref": "#/$defs/digest"},
        "source_commit": {"$ref": "#/$defs/sha"},
        "deploy_workflow_blob": {"$ref": "#/$defs/sha"},
        "migration_horizon_sha256": {"$ref": "#/$defs/digest"},
        "ledger_generation_sha256": {"$ref": "#/$defs/digest"},
        "writer_lock_generation_sha256": {"$ref": "#/$defs/digest"},
        "active_writers": {"type": "integer", "minimum": 0},
        "terminal": {"const": true},
        "terminal_receipt_sha256": {"$ref": "#/$defs/digest"},
        "completed_at": {"$ref": "#/$defs/timestamp"},
        "checkpoint_content": {"$ref": "#/$defs/checkpointContent"},
        "replacement_blocks": {"type": "boolean"},
        "integrity_alarm": {"type": "boolean"},
        "legacy": {"$ref": "#/$defs/legacy"},
        "indexed": {"$ref": "#/$defs/indexed"}
      }
    },
    "controls": {
      "type": "object",
      "additionalProperties": false,
      "required": ["planted_open_row", "artifact_without_ledger", "stale_or_missing_checkpoint"],
      "properties": {
        "planted_open_row": {"$ref": "#/$defs/control"},
        "artifact_without_ledger": {"$ref": "#/$defs/control"},
        "stale_or_missing_checkpoint": {"$ref": "#/$defs/checkpointControl"}
      }
    },
    "checkpointControl": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scenario", "transaction_id", "source_evidence_sha256", "source_commit",
        "deploy_workflow_blob", "migration_horizon_sha256", "ledger_generation_sha256",
        "writer_lock_generation_sha256", "active_writers", "terminal",
        "terminal_receipt_sha256", "completed_at", "checkpoint_state",
        "observed_checkpoint_sha256", "replacement_blocks", "fallback_to_full_scan",
        "fallback_checkpoint_content", "legacy"
      ],
      "properties": {
        "scenario": {"const": "stale_or_missing_checkpoint"},
        "transaction_id": {"$ref": "#/$defs/id"},
        "source_evidence_sha256": {"$ref": "#/$defs/digest"},
        "source_commit": {"$ref": "#/$defs/sha"},
        "deploy_workflow_blob": {"$ref": "#/$defs/sha"},
        "migration_horizon_sha256": {"$ref": "#/$defs/digest"},
        "ledger_generation_sha256": {"$ref": "#/$defs/digest"},
        "writer_lock_generation_sha256": {"$ref": "#/$defs/digest"},
        "active_writers": {"type": "integer", "minimum": 0},
        "terminal": {"const": true},
        "terminal_receipt_sha256": {"$ref": "#/$defs/digest"},
        "completed_at": {"$ref": "#/$defs/timestamp"},
        "checkpoint_state": {"enum": ["stale", "missing"]},
        "observed_checkpoint_sha256": {
          "anyOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]
        },
        "replacement_blocks": {"const": true},
        "fallback_to_full_scan": {"const": true},
        "fallback_checkpoint_content": {"$ref": "#/$defs/checkpointContent"},
        "legacy": {"$ref": "#/$defs/legacy"}
      }
    }
  }
}
