{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://leafdesign.ai/schemas/instant-execution/catalog-entry.v1.schema.json",
  "title": "Leaf instant execution effective catalog digest input v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "catalog_commit", "capability", "execution_class", "runtime", "limits", "code_digest", "artifact_digest", "entrypoint", "params_schema_digest"],
  "properties": {
    "contract": {"const": "leaf.instant-execution/v1"},
    "catalog_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capability_id", "tool_id", "tool_version"],
      "properties": {
        "capability_id": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{2,127}$"},
        "tool_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,127}$"},
        "tool_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"}
      }
    },
    "execution_class": {"const": "instant"},
    "runtime": {"const": "python-3.12"},
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_wall_ms", "max_cpu_ms", "max_memory_mb", "max_output_bytes", "max_tool_calls"],
      "properties": {
        "max_wall_ms": {"type": "integer", "minimum": 1, "maximum": 30000},
        "max_cpu_ms": {"type": "integer", "minimum": 1, "maximum": 30000},
        "max_memory_mb": {"type": "integer", "minimum": 32, "maximum": 4096},
        "max_output_bytes": {"type": "integer", "minimum": 1, "maximum": 10485760},
        "max_tool_calls": {"type": "integer", "minimum": 0, "maximum": 32}
      }
    },
    "code_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "artifact_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "entrypoint": {"type": "string", "pattern": "^[A-Za-z0-9_./:-]{1,256}$"},
    "params_schema_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
