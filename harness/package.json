{
  "name": "leaf-tenant-author-harness",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Tenant-facing design-time author loop on the Anthropic Agent SDK (NL prompt -> deterministic tool package -> register). Design-time only: registered tools run with ZERO LLM.",
  "engines": {
    "node": ">=18.18"
  },
  "scripts": {
    "test": "node --import ./test/enableAuthoredExecution.mjs ./node_modules/vitest/vitest.mjs run --testTimeout=20000 --hookTimeout=30000",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "serve": "node dist/scripts/serve.js",
    "start": "node --experimental-strip-types src/server.ts"
  },
  "devDependencies": {
    "@types/node": "22.10.5",
    "@types/pg": "^8.20.0",
    "typescript": "5.7.3",
    "vite": "6.4.3",
    "vitest": "3.2.6"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.218",
    "e2b": "^2.35.0",
    "pg": "^8.22.0"
  },
  "overrides": {
    "fast-uri": "4.1.1"
  }
}
