# Copy to .env.local to customize. Defaults work for a no-backend demo.
# VITE_MOCK=1 serves tools/run/author from local fixtures (default when unset).
# Set VITE_MOCK=0 to hit the Lane D backend at VITE_API_BASE.
VITE_MOCK=1
VITE_API_BASE=http://localhost:8130

# Live-mode sign-in (Auth0 platform session). Public SPA values — safe to commit.
# Set all three to enable the "Sign in" button; leave unset for the demo-only gate.
# ALSO REQUIRED (operator, per-origin): add this deploy origin to the Auth0 app's
# Allowed Callback URLs + Allowed Web Origins, and set LEAF_CORS_ORIGINS on the backend.
# VITE_AUTH0_DOMAIN=leafautomation.us.auth0.com
# VITE_AUTH0_CLIENT_ID=zkJjr0ZFtcyQjyJ8e4zdkdgzoMaVWt5O
# VITE_AUTH0_AUDIENCE=https://api.leafdesign.ai

# Required when LEAF_E2E_STAGING_JWT is set: lowercase SHA-256 hex of the dedicated staging JWT sub.
LEAF_E2E_STAGING_EXPECTED_SUBJECT_SHA256=
# Optional: lowercase SHA-256 hex of the JWT https://leafdesign.ai/tenant_id claim.
LEAF_E2E_STAGING_EXPECTED_TENANT_SHA256=
# Comma-separated lowercase SHA-256 hex hashes of production subjects that staging must reject.
LEAF_E2E_STAGING_FORBIDDEN_SUBJECT_SHA256S=
