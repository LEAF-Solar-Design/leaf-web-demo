# Build-context prune for the deploy pack (WAVE 5). Keep the context small and
# NEVER ship host-installed deps, compiled output, runtime state, or secrets.
.git
.gitignore
**/node_modules
**/dist
web/dist
harness/dist
**/__pycache__
**/*.pyc
.pytest_cache
**/.pytest_cache
.serena
**/*.log

# Runtime artifacts (regenerated inside the containers / on named volumes)
server/jobs.db
server/jobs.db-shm
server/jobs.db-wal
server/broker_ledger.jsonl
server/broker_tenants.json
server/agent_tenants.json*
server/authored_tools.json
server/drawings/
# Session + customization SQLite DBs (with WAL/SHM sidecars) and the broker
# work queues. Written at runtime, redirected to the leaf-state volume in the
# containers (SESSIONS_DB, docker-compose.yml), and never git-tracked, so a
# clean CI checkout has none of them. Without these lines a dev who ran the
# server locally bakes their own sessions into both images.
server/sessions.db
server/sessions.db-shm
server/sessions.db-wal
server/customization.db
server/customization.db-shm
server/customization.db-wal
server/active_workitems.jsonl
server/pending_reaps.jsonl
# Guest drawing store: raw user-supplied DWG/DXF written at runtime under
# guest_store_dir() (server/write_loop.py, LEAF_GUEST_STORE_DIR). Same
# customer-data class as data/uploads/ below.
server/guest_drawings/
# Guest uploads: raw user-supplied DWG/DXF written at runtime
# (server/routers/uploads.py). Already git-ignored; keep them out of images too.
data/uploads/
# Agent gate-chain state, written at runtime. Both Dockerfiles do
# `COPY data/ /app/data/`, but the gate-state files are redirected to
# /data/state on the leaf-state volume (docker-compose.yml), and no current
# code provisions or reads data/workspaces/, so nothing in either image reads
# any of them. A dev who ran the server locally would otherwise bake stale gate
# decisions and session grants into both images. The trailing * covers the
# sibling .tmp and .lock files (server/agent_gate.py).
data/agent_audit.jsonl
data/agent_ledger.jsonl
data/agent.disabled
data/agent_approvals/
data/agent_session_grants.json*
data/agent_rate_state.json*
data/workspaces/

# Local env / secrets — must never enter an image layer
**/.env.local
.env
.secrets/
**/.grant/
# demo tenant checkouts the harness tests create
harness/.tmp/
harness/tenant-checkouts/

# The deploy pack itself is referenced by dockerfile path, not copied wholesale
# (kept out of the python/node source COPYs implicitly).
