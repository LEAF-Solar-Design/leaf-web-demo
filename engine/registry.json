        "type": "object",
        "properties": {
          "counts": { "type": "object", "additionalProperties": { "type": "integer" } }
        }
      },
      "capabilities": ["drawing.read"],
      "provenance": { "author": "agent", "created": "2026-07-17T00:00:00Z" }
