{
  "tools": [
    {
      "name": "arlo-design",
      "version": "1.0.0",
      "description": "Generate electrical feeder assembly proposals through the local ARLO design worker. Proposals require separate engineering review and native verification.",
      "kind": "solver",
      "engine_op": "arlo_design",
      "family_id": "placement",
      "canonical_only": true,
      "params": {
        "type": "object",
        "properties": {
          "contract": {"type": "string", "enum": ["arlo_design_request_v1"]},
          "organization_id": {"type": "string"},
          "project_id": {"type": "string"},
          "input_version_id": {"type": "string"},
          "scenario": {"type": "object"},
          "catalog_version": {"type": "string", "minLength": 1},
          "requirements_version": {"type": "string", "minLength": 1},
          "catalog": {"type": "array", "items": {"type": "object"}, "minItems": 1},
          "requirements": {"type": "object"},
          "placement_candidates": {"type": "array", "items": {"type": "object"}},
          "native_bindings": {"type": "object"},
          "budget": {"type": "object"},
          "seed": {"type": "integer"},
          "objective_version": {"type": "string"}
        },
        "required": ["contract", "scenario", "catalog_version", "requirements_version", "catalog", "requirements", "placement_candidates"],
        "additionalProperties": false
      },
      "returns": {"type": "object"},
      "capabilities": ["solve"],
      "provenance": {"source": "arlo-3dml/arlo/design", "entry": "python -m arlo.design"}
    },
    {
      "name": "string-autofill-opt",
      "version": "1.0.0",
      "description": "Runs the existing AutoFill target solver and records deterministic input/result hashes and source revision.",
      "kind": "solver",
      "engine_op": "autofill_string_targets",
      "canonical_only": true,
      "params": {
        "type": "object",
        "properties": {
          "groups": { "type": "array", "items": { "type": "object" }, "minItems": 1 },
          "panelsPerString": { "type": "integer", "minimum": 3 },
          "options": { "type": "object" },
          "panelAngle": { "type": "number", "default": 0 },
          "panelWidth": { "type": "number", "default": 0 },
          "panelHeight": { "type": "number", "default": 0 }
        },
        "required": ["groups", "panelsPerString"]
      },
      "returns": { "type": "object" },
      "capabilities": ["solve"],
      "provenance": { "source": "autofill-solver/solver.py", "entry": "solve_targets" }
    },
    {
      "name": "count-by-layer",
      "version": "1.0.0",
      "description": "Counts every model-space entity per layer.",
      "kind": "script",
      "engine_op": "count_by_layer",
      "script": "engine/tools/count_by_layer.lsp",
      "aps_live": true,
      "params": { "type": "object", "properties": {}, "required": [] },
      "returns": {
        "type": "object",
        "properties": {
          "counts": { "type": "object", "additionalProperties": { "type": "integer" } }
        }
      },
      "capabilities": ["drawing.read"],
      "provenance": { "author": "agent", "created": "2026-07-17T00:00:00Z" }
    },
    {
      "name": "measure-panel-area",
      "version": "1.0.0",
      "description": "Sums closed-polyline area (total + per layer) in square feet; assumes 1 drawing unit = 1 inch.",
      "kind": "script",
      "engine_op": "measure_panel_area",
      "script": "engine/tools/measure_panel_area.lsp",
      "params": { "type": "object", "properties": {}, "required": [] },
      "returns": {
        "type": "object",
        "properties": {
          "area_sqft": { "type": "number" },
          "by_layer_sqft": { "type": "object", "additionalProperties": { "type": "number" } },
          "units_assumption": { "type": "string" }
        }
      },
      "capabilities": ["drawing.read"],
      "provenance": { "author": "agent", "created": "2026-07-17T00:00:00Z" }
    },
    {
      "name": "highlight-panels-near-edge",
      "version": "1.0.0",
      "description": "Returns handles of polylines on a layer whose centroid is within a distance of the drawing extents edge.",
      "kind": "script",
      "engine_op": "highlight_panels_near_edge",
      "script": "engine/tools/highlight_panels_near_edge.lsp",
      "params": {
        "type": "object",
        "properties": {
          "layer": { "type": "string", "default": "Panels", "description": "Layer whose polylines are tested." },
          "distance": { "type": "number", "default": 200, "description": "Max distance (drawing units / inches) from an extents edge." }
        },
        "required": []
      },
      "returns": {
        "type": "object",
        "properties": {
          "layer": { "type": "string" },
          "distance": { "type": "number" },
          "matched": { "type": "integer" },
          "extents": { "type": "object" }
        }
      },
      "capabilities": ["drawing.read"],
      "provenance": { "author": "agent", "created": "2026-07-17T00:00:00Z" }
    },
    {
      "name": "string-panels",
      "version": "1.2.0",
      "description": "Bank-clustered, rotation-aware serpentine DC string routing over the Panels layer with an NEC 690.7 cold-temperature string-size check.",
      "kind": "script",
      "engine_op": "string_panels",
      "entry": "builtins/string_panels.py",
      "offline_only": true,
      "params": {
        "type": "object",
        "properties": {
          "module_model": {
            "type": "string",
            "default": "Q.Peak DUO XL-G11.7 / 425",
            "description": "Module model label (marketing-demo default)."
          },
          "voc": {
            "type": "number",
            "default": 48.5,
            "description": "Module open-circuit voltage at STC, volts (demo default)."
          },
          "temp_coeff_pct_per_c": {
            "type": "number",
            "default": -0.27,
            "description": "Voc temperature coefficient, %/degC (demo default)."
          },
          "design_min_temp_c": {
            "type": "number",
            "default": -25.0,
            "description": "Design minimum ambient temperature, degC (demo default)."
          },
          "max_system_voltage": {
            "type": "number",
            "default": 1000.0,
            "description": "NEC 690.7 maximum system voltage, volts (commercial-rooftop demo default)."
          },
          "panel_layer": {
            "type": "string",
            "default": "Panels",
            "description": "Intake layer carrying the closed panel polylines."
          },
          "cluster_radius_factor": {
            "type": "number",
            "default": 3.0,
            "description": "Bank clustering radius as a multiple of the median nearest-neighbor panel distance; strings never cross bank gaps."
          }
        },
        "required": []
      },
      "returns": {
        "type": "object",
        "properties": {
          "module": { "type": "object" },
          "electrical": { "type": "object" },
          "strings": { "type": "array" },
          "stats": { "type": "object" }
        }
      },
      "capabilities": ["drawing.read"],
      "provenance": { "author": "site-demo-lane", "created": "2026-07-20T00:00:00Z" }
    }
  ]
}
