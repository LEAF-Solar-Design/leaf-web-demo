; ==========================================================================
; write_probe.scr  -  Leaf drawing.write spike mutate recipe (READABLE REF)
; --------------------------------------------------------------------------
; Generated by da/write_spike.py from da/write_lisp.build_write_scr(). The DA
; Activity LeafWriteProbe runs these (progn ...) lines headless via
;   accoreconsole /i input.dwg /s <this script>
; Order is load-bearing: DELETE one LWPOLYLINE, MAKE layer LEAF_WRITE_PROBE,
; ADD a closed LWPOLYLINE on it, SAVEAS output.dwg, QUIT. Re-extracting
; output.dwg proves the add (probe layer + polyline present) and the delete
; (exactly one original polyline handle gone).  Do not edit by hand.
; ==========================================================================
(setvar "CMDECHO" 0)
(progn (setq ss (ssget "_X" (list (cons 0 "LWPOLYLINE") (cons 410 "Model")))) (if ss (entdel (ssname ss 0))) (princ "DELETE-DONE"))
(command "_.-LAYER" "_Make" "LEAF_WRITE_PROBE" "")
(progn (entmake (list (cons 0 "LWPOLYLINE") (cons 100 "AcDbEntity") (cons 8 "LEAF_WRITE_PROBE") (cons 100 "AcDbPolyline") (cons 90 4) (cons 70 1) (cons 10 (list 0.0 0.0)) (cons 10 (list 10.0 0.0)) (cons 10 (list 10.0 10.0)) (cons 10 (list 0.0 10.0)))) (princ "ADD-DONE"))
(command "_.SAVEAS" "" "output.dwg")
(command "_.QUIT" "_Y")
