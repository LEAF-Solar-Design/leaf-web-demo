<?xml version="1.0" encoding="utf-8"?>
<!--
  PackageContents.xml - APS Design Automation AppBundle manifest for LeafCutListTools.
  Engine: Autodesk.AutoCAD+26_0 (net8). SeriesMin R25.0 covers 2025/2026 engines.
  The Activity invokes LEAFCUTLIST; the command writes result.json to the working dir.
-->
<ApplicationPackage
    SchemaVersion="1.0"
    Version="1.0.0"
    ProductCode="{5B0D2D8E-6C4A-4F8E-9A1B-C0D1E2F3A4B5}"
    Name="LeafCutListTools"
    Description="Leaf timber cut-list tool (CutLists.Core engine)"
    Author="Leaf">
  <CompanyDetails Name="Leaf" Url="https://leafdesign.ai" Email="ehaug@leafautomation.ai" />
  <Components Description="LeafCutListTools managed module">
    <RuntimeRequirements OS="Win64" Platform="AutoCAD" SeriesMin="R25.0" />
    <ComponentEntry
        AppName="LeafCutListTools"
        Version="1.0.0"
        ModuleName="./Contents/LeafCutListTools.dll"
        AppDescription="timber-cutlist: plans and elevations -> timber quantities, lengths, connections"
        LoadOnAutoCADStartup="False"
        LoadOnCommandInvocation="True">
      <Commands GroupName="LeafCutListTools">
        <Command Global="LEAFCUTLIST" Local="LEAFCUTLIST" />
      </Commands>
    </ComponentEntry>
  </Components>
</ApplicationPackage>
