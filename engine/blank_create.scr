; =========================================================================
; blank_create.scr  -  Leaf blank-DWG CREATE recipe (READABLE REFERENCE)
; -------------------------------------------------------------------------
; Generated by da/blank_spike.py from da/blank_lisp.build_blank_scr().
; The DA Activity LeafBlankCreate runs the per-run version of these lines
; headless via:  accoreconsole /s <this script>   -- note NO /i: there is
; no input drawing, the engine opens its own acad.dwt.
; LEAF_BLANK_XXXXXXXXXXXX below is a PLACEHOLDER. The live script carries a
; per-run uuid-derived marker layer, which the read round-trip asserts on so
; another drawing's bytes can never be mistaken for this run's output.
; Do not edit by hand.
; =========================================================================
(setvar "CMDECHO" 0)
(command "_.-LAYER" "_Make" "LEAF_BLANK_XXXXXXXXXXXX" "")
(progn (princ "LEAF-BLANK-MARKER=LEAF_BLANK_XXXXXXXXXXXX") (princ))
(command "_.SAVEAS" "2018" "output.dwg")
(progn (princ "LEAF-BLANK-SAVED") (princ))
(command "_.QUIT" "_Y")
