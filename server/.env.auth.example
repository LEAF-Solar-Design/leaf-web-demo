# ---------------------------------------------------------------------------
# Concern 1 — Leaf PLATFORM identity (Auth0). Copy to `.env` (or export) and set
# LEAF_AUTH_LIVE=1 to ENFORCE Bearer-token auth on the server.
#
# With LEAF_AUTH_LIVE unset or 0 (default) the demo is byte-identical to today:
# no Authorization required, the X-Tenant-Id header stub still drives the
# jobs/broker chain, and PyJWT is never imported.
#
# All values below are the ROOT-ASSUMED DEFAULTS (reuse the existing
# leafautomation.us.auth0.com tenant + api.leafdesign.ai audience + free
# app_metadata.organization_id org model) pending operator confirmation — see
# contract/AUTH.md "Operator: Auth0 dashboard steps".
#
# INVARIANT: nothing in this file is a Claude/Anthropic credential. The user's
# "sign in with Claude" Agent-SDK OAuth is a SEPARATE concern (sibling
# hosted-oauth-spike) and is never configured here. See contract/AUTH.md.
# ---------------------------------------------------------------------------

LEAF_AUTH_LIVE=0

# Auth0 verification parameters (RS256; must match the token's iss/aud).
LEAF_AUTH0_ISSUER=https://leafautomation.us.auth0.com/
LEAF_AUTH0_AUDIENCE=https://api.leafdesign.ai
LEAF_AUTH0_JWKS_URL=https://leafautomation.us.auth0.com/.well-known/jwks.json

# Namespaced-claim prefix minted by the Post-Login Action (trailing slash added
# if omitted). Claims read: <ns>tenant_id, <ns>org_id, <ns>tier.
LEAF_TENANT_CLAIM_NS=https://leafdesign.ai/

# --- optional overrides ----------------------------------------------------
# Offline/test hook: verify against a LOCAL JWKS json instead of fetching the
# remote URL (no live Auth0). server/test_auth.py sets this to a temp file.
# LEAF_AUTH0_JWKS_FILE=/abs/path/to/local-jwks.json

# JSON tenant store location + where tenant workspaces are rooted.
# LEAF_TENANTS_FILE=../data/tenants.sample.json
# LEAF_WORKSPACE_BASE=../data/workspaces
