{
  "_note": "Operator-owned agent action catalog (agent spine Phase 1). The catalog IS the guardrail: the conversational agent can only be gated through actions defined here, at the policy tier the operator set (auto / confirm-once / always-confirm). Read at request time by server/agent_policy.py (env-overridable LEAF_AGENT_POLICY_FILE); strict-validated — unknown fields are load errors. tier_overrides may retune a tier's policy but can never loosen an action whose tenant_tightenable is false. Per-tenant overlays (agent_tenants.json beside this file) can only TIGHTEN.",
  "version": 1,
  "approval_ttl_s": 300,
  "rate_limits": {
    "low_per_hour": 120,
    "medium_per_hour": 60,
    "high_per_hour": 10
  },
  "actions": {
    "request_confirmation": {
      "description": "UI-only consent chip: ask the user to approve something before proceeding (R0; wire contract section 5). Dispatches nowhere — the gate mints the confirmation_id and the harness renders the card, then ends the turn. always-confirm is what MAKES the id: the app's pending store is the only authority allowed to mint one (section 6), so a self-issued harness id could never be redeemed.",
      "rung": 0,
      "required_capability": "converse",
      "policy": "always-confirm",
      "tenant_tightenable": false,
      "dispatch": {
        "kind": "app_api",
        "routes": []
      },
      "args_schema": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string"
          },
          "payload": {
            "type": "object"
          },
          "confirmation_id": {
            "type": "string"
          }
        },
        "required": [
          "kind"
        ],
        "additionalProperties": false
      },
      "rate_limit_category": "low",
      "timeout_s": 30,
      "audit_extra": [
        "kind"
      ]
    },
    "read_platform_state": {
      "description": "Read platform state: catalog, usage, jobs, versions, own audit (R1). Also the consult surface for the R7 READ side (change list, source file, source tree) - read-only GETs whose routes re-run the full admin admission chain server-side, so this auto policy widens reachability, never authority.",
      "rung": 1,
      "required_capability": "converse",
      "policy": "auto",
      "dispatch": {
        "kind": "app_api",
        "routes": [
          "GET /api/capabilities",
          "GET /api/usage",
          "GET /api/jobs",
          "GET /api/drawings/*",
          "GET /api/agent/audit",
          "GET /api/platform/customize",
          "GET /api/platform/source",
          "GET /api/platform/source/tree",
          "POST /api/campaigns/conversation/status"
        ]
      },
      "args_schema": {
        "type": "object",
        "properties": {
          "what": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "rate_limit_category": "low",
      "timeout_s": 30,
      "audit_extra": [
        "what"
      ]
    },
    "run_read_tool": {
      "description": "Dispatch a registered drawing.read tool via POST /api/run (R2).",
      "rung": 2,
      "required_capability": "run_read",
      "policy": "auto",
      "dispatch": {
        "kind": "app_api",
        "routes": [
          "POST /api/run"
        ]
      },
      "args_schema": {
        "type": "object",
        "properties": {
          "tool": {
            "type": "string"
          },
          "params": {
            "type": "object"
          },
          "dwg": {
            "type": "string"
          },
          "catalog_digest": {
            "type": "string"
          },
          "drawing_version": {
            "type": "integer"
          },
          "expected_drawing_head": {
            "type": "integer"
          },
          "catalog_commit": {
            "type": "string"
          },
          "effective_catalog_digest": {
            "type": "string"
          },
          "tool_manifest_sha256": {
            "type": "string"
          },
          "confirmation_id": {
            "type": "string"
          }
        },
        "required": [
          "tool"
        ],
        "additionalProperties": false
      },
      "rate_limit_category": "medium",
      "timeout_s": 60,
      "audit_extra": [
        "tool",
        "dwg"
      ]
    },
    "run_write_tool": {
      "description": "Dispatch a registered drawing.write tool via POST /api/run (R3; creates vN+1, undoable). Every execution requires a fresh approval.",
      "rung": 3,
      "required_capability": "run_write",
      "policy": "always-confirm",
      "tenant_tightenable": false,
      "dispatch": {
        "kind": "app_api",
        "routes": [
          "POST /api/run"
        ]
      },
      "args_schema": {
        "type": "object",
        "properties": {
          "tool": {
            "type": "string"
          },
          "params": {
            "type": "object"
          },
          "dwg": {
            "type": "string"
          },
          "catalog_digest": {
            "type": "string"
          },
          "drawing_version": {
            "type": "integer"
          },
          "expected_drawing_head": {
            "type": "integer"
          },
          "catalog_commit": {
            "type": "string"
          },
          "effective_catalog_digest": {
            "type": "string"
          },
          "tool_manifest_sha256": {
            "type": "string"
          },
          "confirmation_id": {
            "type": "string"
          }
        },
        "required": [
          "tool"
        ],
        "additionalProperties": false
      },
      "rate_limit_category": "medium",
      "timeout_s": 120,
      "audit_extra": [
        "tool",
        "dwg"
      ],
      "cost_class": "write"
    },
    "submit_live_solve": {
      "description": "Dispatch a live APS run (real USD; R4). Broker USD-cap preflight still fires underneath.",
      "rung": 4,
      "required_capability": "run_write",
      "policy": "confirm-once",
      "dispatch": {
        "kind": "app_api",
        "routes": [
          "POST /api/run"
        ]
      },
      "args_schema": {
        "type": "object",
        "properties": {
          "tool": {
            "type": "string"
          },
          "params": {
            "type": "object"
          },
          "dwg": {
            "type": "string"
          },
          "catalog_digest": {
            "type": "string"
          },
          "drawing_version": {
            "type": "integer"
          },
          "expected_drawing_head": {
            "type": "integer"
          },
          "catalog_commit": {
            "type": "string"
          },
          "effective_catalog_digest": {
            "type": "string"
          },
          "tool_manifest_sha256": {
            "type": "string"
          },
          "confirmation_id": {
            "type": "string"
          }
        },
        "required": [
          "tool"
        ],
        "additionalProperties": false
      },
      "rate_limit_category": "high",
      "timeout_s": 600,
      "audit_extra": [
        "tool",
        "dwg"
      ],
      "cost_class": "aps_usd"
    },
    "undo_drawing_version": {
      "description": "Undo: repoint the drawing head to a prior version (R3 safety valve — never harder than the write). DISABLED in Phase-1: no spine tool dispatches it and the wire contract §0 back-edge allowlist carries only GET /api/drawings/*, so POST /api/drawings/{dwg}/undo is unreachable from the harness and would 401. The user-facing undo is unaffected (the UI calls that route directly with a tenant token). Enabling this needs a contract revision adding the route to §0 plus a spine mapping — Phase-2.",
      "rung": 3,
      "required_capability": "run_write",
      "policy": "auto",
      "enabled": false,
      "dispatch": {
        "kind": "app_api",
        "routes": []
      },
      "args_schema": {
        "type": "object",
        "properties": {
          "dwg": {
            "type": "string"
          },
          "to_version": {
            "type": "integer"
          }
        },
        "additionalProperties": false
      },
      "rate_limit_category": "medium",
      "timeout_s": 30,
      "audit_extra": [
        "dwg",
        "to_version"
      ]
    },
    "author_tool": {
      "description": "Author a new tool, or revise one explicitly named authored tool, in the design-time sandbox (R5; nothing registered until R6).",
      "rung": 5,
      "required_capability": "build",
      "policy": "confirm-once",
      "dispatch": {
        "kind": "harness",
        "routes": [
          "POST /author"
        ]
      },
      "args_schema": {
        "type": "object",
        "properties": {
          "description": {
            "type": "string"
          },
          "mode": {
            "type": "string",
            "enum": [
              "build",
              "one_off"
            ]
          },
          "target_tool_name": {
            "type": "string"
          },
          "confirmation_id": {
            "type": "string"
          }
        },
        "required": [
          "description"
        ],
        "additionalProperties": false
      },
      "rate_limit_category": "high",
      "timeout_s": 600,
      "audit_extra": []
    },
    "request_publication": {
      "description": "Request or resume publication of one durable staged change. The request carries only change_set_id; the app loads all receipt fields and applies the current account publication policy before publication.",
      "rung": 6,
      "required_capability": "deploy",
      "policy": "auto",
      "tenant_tightenable": false,
      "dispatch": {
        "kind": "app_api",
        "routes": [
          "POST /api/author/publication-requests"
        ]
      },
      "args_schema": {
        "type": "object",
        "properties": {
          "change_set_id": {
            "type": "string"
          }
        },
        "required": [
          "change_set_id"
        ],
        "additionalProperties": false
      },
      "rate_limit_category": "high",
      "timeout_s": 120,
      "audit_extra": [
        "change_set_id"
      ]
    },
    "register_tool": {
      "description": "Register/deploy an authored tool into the runnable catalog (R6; highest-leverage injection target).",
      "rung": 6,
      "required_capability": "deploy",
      "policy": "always-confirm",
      "tenant_tightenable": false,
      "dispatch": {
        "kind": "app_api",
        "routes": [
          "POST /api/author/register"
        ]
      },
      "args_schema": {
        "type": "object",
        "properties": {
          "change_set_id": {
            "type": "string"
          },
          "staged_commit": {
            "type": "string"
          },
          "catalog_digest": {
            "type": "string"
          },
          "platform_release": {
            "type": "string"
          },
          "workspace_contract_digest": {
            "type": "string"
          },
          "confirmation_id": {
            "type": "string"
          },
          "idempotency_key": {
            "type": "string"
          }
        },
        "required": [
          "change_set_id",
          "staged_commit",
          "catalog_digest",
          "platform_release",
          "workspace_contract_digest",
          "idempotency_key"
        ],
        "additionalProperties": false
      },
      "rate_limit_category": "high",
      "timeout_s": 120,
      "audit_extra": [
        "change_set_id",
        "catalog_digest"
      ]
    },
    "customize_platform": {
      "description": "Platform self-edit (R7, W14 admin lane): propose a BRANCH-ONLY change to the platform repo itself, then land it into the standing branch->PR->review->merge->staging-canary->prod pipeline. Reachable only by the operator-granted `admin` tier (the sole platform_customize grant), only when LEAF_CUSTOMIZATION_R7_MODE=internal lists the tenant, and every invocation takes a fresh approval. Fundamental paths (auth, billing, agent spine) additionally require the out-of-band co-sign secret before landing (docs/ADMIN-SELF-EDIT-LANE.md).",
      "rung": 7,
      "required_capability": "platform_customize",
      "policy": "always-confirm",
      "tenant_tightenable": false,
      "dispatch": {
        "kind": "app_api",
        "routes": [
          "POST /api/platform/customize",
          "GET /api/platform/customize/*",
          "POST /api/platform/customize/*/land"
        ]
      },
      "args_schema": {
        "type": "object",
        "properties": {
          "op": {
            "type": "string",
            "enum": [
              "propose",
              "land"
            ]
          },
          "title": {
            "type": "string"
          },
          "edits": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string"
                },
                "content": {
                  "type": "string"
                },
                "delete": {
                  "type": "boolean"
                }
              },
              "required": [
                "path"
              ],
              "additionalProperties": false
            }
          },
          "change_id": {
            "type": "string"
          },
          "commit_sha": {
            "type": "string"
          },
          "confirmation_id": {
            "type": "string"
          }
        },
        "required": [
          "op"
        ],
        "additionalProperties": false
      },
      "rate_limit_category": "high",
      "timeout_s": 600,
      "audit_extra": [
        "title",
        "change_id"
      ]
    },
    "propose_overlay": {
      "description": "T1 runtime overlay: open a PENDING colour/copy preview for THIS session (server/overlay_propose.py). Writes one session-scoped row, changes nothing another user can see, and expires by lease. Deliberately `auto`: the proposal is the cheap half, and the irreversible half is the operator tap that applies it to the tenant, which carries its own CAS witness and audit row. Requiring a confirmation here would buy nothing and cost the immediacy the tier exists for.",
      "rung": 2,
      "required_capability": "converse",
      "policy": "auto",
      "tenant_tightenable": true,
      "dispatch": {
        "kind": "app_api",
        "routes": [
          "POST /api/overlay/proposals"
        ]
      },
      "args_schema": {
        "type": "object",
        "properties": {
          "tokens": {
            "type": "object",
            "description": "token id -> requested value, e.g. {\"color.canvas.bg\": \"#ffffff\"}. Validated against the closed registry; unknown ids are refused.",
            "additionalProperties": {
              "type": "string"
            }
          },
          "request_text": {
            "type": "string",
            "description": "the user's own words, echoed on the operator card"
          }
        },
        "required": [
          "tokens"
        ],
        "additionalProperties": false
      },
      "rate_limit_category": "medium",
      "timeout_s": 20,
      "audit_extra": [
        "request_text"
      ]
    },
    "finish_project": {
      "description": "Record a bounded release goal for THIS conversation's authenticated project through the completion engine, and drive its existing bounded engine operations. Args are declarative only (title, prompt, delivery_profile, intended_user, workflow, artifact_refs); the model can never supply org, project, grants, commands, source revision, authoritative checks, evidence, or completion flags, and the project is derived from the authenticated session, never from the request. Grants no new spending/provider/publication scope beyond the existing bounded release engine.",
      "rung": 2,
      "required_capability": "converse",
      "policy": "auto",
      "tenant_tightenable": true,
      "dispatch": {
        "kind": "app_api",
        "routes": [
          "POST /api/campaigns/conversation/finish"
        ]
      },
      "args_schema": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "prompt": {
            "type": "string"
          },
          "delivery_profile": {
            "type": "string"
          },
          "intended_user": {
            "type": "string"
          },
          "workflow": {
            "type": "string"
          },
          "artifact_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "title",
          "prompt",
          "delivery_profile",
          "intended_user",
          "workflow",
          "artifact_refs"
        ],
        "additionalProperties": false
      },
      "rate_limit_category": "medium",
      "timeout_s": 30,
      "audit_extra": [
        "delivery_profile"
      ]
    }
  },
  "tier_overrides": {}
}
