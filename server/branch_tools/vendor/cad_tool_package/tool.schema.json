{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:leaf:tool-package:tool.json:v1",
  "title": "Tool-package manifest v1 (contract/CONTRACT.md section 3)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "version",
    "description",
    "entry",
    "params",
    "returns",
    "capabilities",
    "hosts",
    "timeout_ms",
    "idempotent",
    "provenance",
    "review"
  ],
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$",
      "minLength": 3,
      "maxLength": 64
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "entry": {
      "const": "main.csx"
    },
    "family": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$",
      "minLength": 3,
      "maxLength": 64
    },
    "params": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "const": "object" }
      }
    },
    "returns": {
      "type": "object"
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(drawing\\.(read|write)|files\\.(read|write):.+|net\\.http:.+)$"
      }
    },
    "hosts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["min_release", "min_host_api"],
      "properties": {
        "min_release": { "type": "integer", "minimum": 2018, "maximum": 2030 },
        "min_host_api": { "type": "integer", "minimum": 1 }
      }
    },
    "timeout_ms": {
      "type": "integer",
      "minimum": 1,
      "maximum": 600000
    },
    "idempotent": {
      "type": "boolean"
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["author", "session", "created", "modified"],
      "properties": {
        "author": { "enum": ["agent", "human"] },
        "session": { "type": "string", "minLength": 1, "maxLength": 200 },
        "created": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$" },
        "modified": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$" }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": { "enum": ["unreviewed", "reviewed", "rejected"] }
      }
    }
  }
}
