{
  "schema": "leaf.solar-tool.v1",
  "name": "solar-assignment-report",
  "builtin": "builtins/solar_assignment_report.py",
  "family": "stringing",
  "adapter": "local-graph-read",
  "entitlement": "run_read",
  "requires_persisted_graph": true,
  "seedable": false,
  "invalid_request_code": "INVALID_STRING_ASSIGNMENT_REQUEST",
  "readiness": {"kind": "hook"},
  "engine": "server-builtin",
  "interaction": {"mode": "form"},
  "record_store": "registry",
  "record": {
    "name": "solar-assignment-report",
    "version": "1.1.0",
    "description": "Read saved string assignments and nominal spare DC inputs by collector in saved mode. Supply inverter_refs to compare selected inverters by occupied input share and review per-string voltage evidence. Saved mode can also suggest minimum direct moves from overloaded inverters to spare inputs using stored cold DC voltage and nameplate power. The search examines up to 64 probes and reports search_limit if a search bound prevents a conclusion. The default mode previews tentative assignments without committing. Enable balance_whole_strings in preview mode to distribute intact unassigned strings and report collector limits.",
    "kind": "script",
    "family_id": "stringing",
    "engine_op": "solar_assignment_report",
    "entry": "builtins/solar_assignment_report.py",
    "params": {
      "type": "object",
      "properties": {
        "drawing_id": {"type": "string", "maxLength": 128},
        "expected_rev": {"type": "integer", "minimum": 0, "maximum": 2147483647},
        "accept_excess_capacity": {"type": "boolean"},
        "balance_whole_strings": {"type": "boolean"},
        "mode": {"type": "string", "enum": ["saved"]},
        "suggest_minimum_moves": {"type": "boolean"},
        "inverter_refs": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      },
      "required": ["expected_rev"],
      "if": {"required": ["mode"]},
      "then": {"not": {"required": ["balance_whole_strings"]}},
      "else": {
        "required": ["accept_excess_capacity"],
        "not": {"anyOf": [{"required": ["suggest_minimum_moves"]}, {"required": ["inverter_refs"]}]}
      },
      "additionalProperties": false
    },
    "returns": {
      "type": "object",
      "required": ["schema", "expected_rev", "status", "committed", "saved_state"],
      "if": {"properties": {"status": {"const": "saved"}}},
      "then": {"required": ["electrical_suitability"]},
      "else": {"required": ["commit_refusal_code", "eligible_string_refs", "candidate_assignments", "remaining_string_refs", "counts"]},
      "properties": {
        "schema": {"const": "leaf.solar-assignment-report.v1"},
        "expected_rev": {"type": "integer", "minimum": 0},
        "status": {"enum": ["complete", "partial", "unassigned", "saved"]},
        "committed": {"const": false},
        "commit_refusal_code": {"type": ["string", "null"]},
        "balance_lines": {"type": "array", "items": {"type": "string"}},
        "electrical_suitability": {
          "type": "object",
          "required": ["status", "reason"],
          "properties": {
            "status": {"const": "unknown"},
            "reason": {"const": "mppt_voltage_current_limits_not_verified"}
          },
          "additionalProperties": false
        },
        "rebalance": {
          "type": "object",
          "required": ["source_rev", "status", "minimum_moves", "moves", "probes_examined", "probe_limit"],
          "properties": {
            "source_rev": {"type": "integer", "minimum": 0},
            "status": {"enum": ["already_balanced", "proposed", "no_direct_solution", "unavailable", "search_limit"]},
            "minimum_moves": {"type": ["integer", "null"], "minimum": 0},
            "moves": {"type": "array", "items": {"type": "object"}},
            "probes_examined": {"type": "integer", "minimum": 0},
            "probe_limit": {"type": "integer", "minimum": 1}
          },
          "additionalProperties": false
        },
        "inverter_comparison": {
          "type": "object",
          "required": ["design_min_temp_c", "least_utilized_inverter_refs", "groups"],
          "properties": {
            "design_min_temp_c": {"type": ["number", "null"]},
            "least_utilized_inverter_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
            "groups": {
              "type": "array",
              "minItems": 2,
              "items": {
                "type": "object",
                "required": ["capacity", "strings"],
                "properties": {
                  "capacity": {"$ref": "#/properties/saved_state/properties/collector_capacity/items"},
                  "strings": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": ["string_ref", "inverter_ref", "circuit_tag", "module_count", "cold_dc_limit", "hot_mppt_window"],
                      "properties": {
                        "string_ref": {"type": "string"},
                        "inverter_ref": {"type": "string"},
                        "circuit_tag": {"type": "string"},
                        "module_count": {"type": "integer", "minimum": 0},
                        "cold_dc_limit": {
                          "type": "object",
                          "required": ["status"],
                          "properties": {
                            "status": {"enum": ["pass", "fail", "unverified"]},
                            "reason": {"type": "string"},
                            "voc_v": {"type": "number"},
                            "saved_inverter_max_dc_v": {"type": "number"}
                          },
                          "if": {"properties": {"status": {"const": "unverified"}}},
                          "then": {"required": ["reason"]},
                          "else": {"required": ["voc_v", "saved_inverter_max_dc_v"]},
                          "additionalProperties": false
                        },
                        "hot_mppt_window": {
                          "type": "object",
                          "required": ["status", "reason"],
                          "properties": {
                            "status": {"const": "unverified"},
                            "reason": {"const": "vmp_temperature_model_required"}
                          },
                          "additionalProperties": false
                        }
                      },
                      "additionalProperties": false
                    }
                  }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        },
        "saved_state": {
          "type": "object",
          "required": ["assignments", "unassigned_string_refs", "collector_capacity"],
          "properties": {
            "assignments": {"type": "array", "items": {"type": "object"}},
            "unassigned_string_refs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
            "collector_capacity": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["inverter_ref", "total_dc_inputs", "occupied_inputs", "spare_inputs"],
                "properties": {
                  "inverter_ref": {"type": "string"},
                  "total_dc_inputs": {"type": "integer", "minimum": 0},
                  "occupied_inputs": {"type": "integer", "minimum": 0},
                  "spare_inputs": {"type": "integer", "minimum": 0}
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        },
        "eligible_string_refs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "remaining_string_refs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "candidate_assignments": {"type": "array", "items": {"type": "object"}},
        "counts": {"type": "object"}
      },
      "additionalProperties": false
    },
    "capabilities": ["drawing.read"],
    "allow_local_fallback": false
  },
  "ledger": ["assign-strings"],
  "trusted_inputs": [],
  "maturity": "preview",
  "wave": 2,
  "order": 83,
  "scenario": "w2-rooftop"
}
