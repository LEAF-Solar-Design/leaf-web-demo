{
  "schema": "leaf.solar-tool.v1",
  "name": "solar-solaredge-tracking-read",
  "builtin": "builtins/solar_solaredge_tracking_read.py",
  "family": "imports",
  "adapter": "local-graph-read",
  "entitlement": "run_read",
  "requires_persisted_graph": true,
  "seedable": false,
  "invalid_request_code": "INVALID_SOLAREDGE_TRACKING_READ_REQUEST",
  "readiness": {
    "kind": "facets",
    "facets": []
  },
  "engine": "server-builtin",
  "interaction": {
    "mode": "form"
  },
  "record_store": "registry",
  "record": {
    "name": "solar-solaredge-tracking-read",
    "version": "1.0.0",
    "description": "Show the accepted SolarEdge tracking: which PDF inverter and string input each panel was labelled with, the PDF and report it came from, and whether those panels still match the drawing. Labels only; no electrical design.",
    "kind": "script",
    "family_id": "imports",
    "engine_op": "solar_solaredge_tracking_read",
    "entry": "builtins/solar_solaredge_tracking_read.py",
    "params": {
      "type": "object",
      "properties": {
        "drawing_id": {
          "type": "string",
          "maxLength": 128
        },
        "section": {
          "type": "string",
          "description": "reference_changes lists missing frames, missing panels, moved panels with saved and current frame references, and new framed panels. saved_assignment_changes compares accepted tracking in two explicit versions of the same project drawing and returns each report's download reference. optimizer_assignment_changes compares saved electrical string membership with a complete current report by shared panel identity. optimizers pages explicit report measurement rows, including partial observations. When an optimizer measurement summary includes optimizer_rows, use optimizers for details and strings for available optimizer_count values.",
          "enum": [
            "strings",
            "frames",
            "unassigned",
            "reference_changes",
            "saved_assignment_changes",
            "optimizer_assignment_changes",
            "optimizers"
          ],
          "default": "strings"
        },
        "compare_to_version_id": {
          "type": "string",
          "minLength": 36,
          "maxLength": 36,
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
          "description": "Baseline saved version UUID for saved_assignment_changes. The version in the request URL is the other side of the comparison."
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 410000,
          "default": 0
        }
      },
      "allOf": [
        {
          "if": {
            "required": ["section"],
            "properties": {"section": {"enum": ["reference_changes", "saved_assignment_changes"]}}
          },
          "else": {"properties": {"offset": {"maximum": 200000}}}
        },
        {
          "if": {
            "required": ["section"],
            "properties": {"section": {"const": "saved_assignment_changes"}}
          },
          "then": {
            "required": ["compare_to_version_id"],
            "properties": {"offset": {"maximum": 400000}}
          },
          "else": {"not": {"required": ["compare_to_version_id"]}}
        }
      ],
      "required": [],
      "additionalProperties": false
    },
    "returns": {
      "type": "object"
    },
    "capabilities": [
      "drawing.read"
    ],
    "allow_local_fallback": false
  },
  "ledger": [
    "import-solaredge-pdf"
  ],
  "trusted_inputs": [],
  "maturity": "preview",
  "wave": 4,
  "order": 31,
  "scenario": "w4-solaredge"
}
