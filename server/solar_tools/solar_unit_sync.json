        "distance_unit": {"type": "string", "enum": ["Meters", "Feet"]}
      },
      "required": ["expected_rev", "distance_unit"],
      "additionalProperties": false
    },
    "returns": {"type": "object"},
    "capabilities": ["drawing.write"],
    "allow_local_fallback": false
  },
  "ledger": ["unit-sync"],
  "trusted_inputs": [],
  "maturity": "preview",
  "wave": 2,
  "order": 10,
  "scenario": "w2-rooftop"
