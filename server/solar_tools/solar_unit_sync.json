{
  "schema": "leaf.solar-tool.v1",
  "name": "solar-unit-sync",
  "builtin": "builtins/solar_unit_sync.py",
  "family": "settings",
  "adapter": "local-graph-commit",
  "entitlement": "run_write",
  "requires_persisted_graph": true,
  "seedable": false,
  "invalid_request_code": "INVALID_UNIT_SYNC_REQUEST",
  "readiness": {"kind": "facets", "facets": []},
  "engine": "server-builtin",
