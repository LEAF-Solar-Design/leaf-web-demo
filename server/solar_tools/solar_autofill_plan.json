      "required": [],
      "additionalProperties": false
    },
    "returns": {"type": "object"},
    "capabilities": ["drawing.read"],
    "allow_local_fallback": false
  },
  "ledger": ["auto-fill"],
  "trusted_inputs": [],
  "maturity": "preview",
  "wave": 2,
  "order": 58,
  "scenario": "w2-rooftop"
