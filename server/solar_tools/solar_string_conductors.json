{
  "schema": "leaf.solar-tool.v1",
  "name": "solar-string-conductors",
  "builtin": "builtins/solar_string_conductors.py",
  "family": "stringing",
  "adapter": "local-graph-commit",
  "entitlement": "run_write",
  "requires_persisted_graph": true,
  "seedable": false,
  "invalid_request_code": "INVALID_CONDUCTOR_REQUEST",
  "readiness": {"kind": "facets", "facets": ["strings"]},
