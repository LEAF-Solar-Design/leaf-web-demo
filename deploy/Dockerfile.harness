# syntax=docker/dockerfile:1
#
# Leaf platform — tenant author HARNESS sidecar (CONTRACT-ADDENDUM §15/§16).
#
# The Build lane's real Agent SDK author loop over HTTP. Per-tenant Claude grant
# store + per-tenant "mushy" git repos. The design-time author path is the ONLY
# Anthropic egress; registered tools run with ZERO LLM.  Listens on :8150.
#
# The Claude grant is provided at RUNTIME (per-tenant token files under
# LEAF_GRANTS_DIR, or the demo LEAF_GRANT_FILE) — NEVER baked into the image.
FROM node:22-bookworm AS trust-store

FROM node:22-slim AS harness

# The self-hosted build runner cannot reach Debian mirrors over port 80. Seed
# TLS trust from the full Node image, then rewrite the slim image's Debian
# sources before the first apt metadata request.
COPY --from=trust-store /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt

# git: the tenant repos are REAL git repos (provision + one seed commit + commit
# on each authoring). The git worker (scripts/git-worker.cjs) is spawned at boot;
# on Linux the SDK-process-tree spawn hazard it guards against does not occur, so
# it is harmless-but-present here (load-bearing on a Windows host).
RUN find /etc/apt -type f \( -name '*.list' -o -name '*.sources' \) \
    -exec sed -i \
      -e 's|http://deb.debian.org|https://deb.debian.org|g' \
      -e 's|http://security.debian.org|https://security.debian.org|g' {} + \
  && apt-get update \
  && apt-get install -y --no-install-recommends git ca-certificates \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install against the lockfile first (layer cache), then bring source + compile.
COPY harness/package.json harness/package-lock.json /app/
RUN npm ci

# Source. scripts/git-worker.cjs is NOT compiled by tsc; the vendored
# gitWorker.js walks UPWARD from its own dist location until it finds a
# scripts/git-worker.cjs, which from dist/src/vendor/... exits at /app —
# so the worker script must live at the harness root (/app/scripts/).
COPY harness/tsconfig.json harness/tsconfig.build.json /app/
COPY harness/src/     /app/src/
COPY harness/scripts/ /app/scripts/
COPY harness/test/    /app/test/

# Compile TS -> /app/dist (dist/scripts/serve.js + dist/src/**), then drop the
# dev toolchain (typescript/vitest/@types) — the runtime keeps only the SDK dep.
RUN npx tsc -p tsconfig.build.json \
  && npm prune --omit=dev \
  && chmod 0555 /app/scripts/start-harness.sh

# F11: authored tenant repositories and grant metadata are writable only through
# the dedicated non-root harness identity.
RUN useradd --system --uid 10002 --user-group --home /home/leaf --create-home leaf \
  && mkdir -p /data/tenants /data/grants /data/sessions \
  && chown -R 10002:10002 /data /home/leaf

# --- Runtime proof that the shipped scripts survived the build. ---------------
# Same guard, same reasoning, and the same EXACT spelling as deploy/Dockerfile.app
# (read the long comment there for why each part is load-bearing; it is not
# repeated in four files). In short: EXEC FORM so a `SHELL ["/bin/true"]` above
# it cannot turn the guard into a no-op, and `-s` as well as `-f` because `-f`
# alone accepts an EMPTY file. This image's CMD *is* one of the guarded files, so
# a deletion currently surfaces as a container that will not start, and a
# TRUNCATION as one that starts, exits 0 immediately, and serves nothing.
#
# EVERY file of harness/scripts/, not a hand-picked subset, because the COPY is a
# DIRECTORY copy: whatever is in that directory is what ships, so that is what
# the guard asserts. The list is derived from the directory rather than curated,
# which means adding a file there reddens
# test_every_image_asserts_its_shipped_scripts_at_build_time until this line is
# updated. That is the intended cost -- it is the same "covered the day it is
# copied" property the app image gets, applied to a directory.
#
# Below the tsc/chmod and useradd RUNs that touch these paths, and ABOVE the
# per-commit ARG: a RUN below that ARG re-executes on every merge, which
# scripts/test_build_platform_images_workflow.py forbids outright, and an
# exec-form RUN can never satisfy its consumption rule (it invokes no shell).
RUN ["/bin/sh", "-c", "test -f /app/scripts/drive.ts && test -s /app/scripts/drive.ts && test -f /app/scripts/e2b-tool-exec.mjs && test -s /app/scripts/e2b-tool-exec.mjs && test -f /app/scripts/e2b-vendor-eval.mjs && test -s /app/scripts/e2b-vendor-eval.mjs && test -f /app/scripts/git-worker.cjs && test -s /app/scripts/git-worker.cjs && test -f /app/scripts/serve.ts && test -s /app/scripts/serve.ts && test -f /app/scripts/start-harness.sh && test -s /app/scripts/start-harness.sh"]

# Declared below every non-consuming instruction, deliberately: this value is a
# new commit sha on every build, and a changed in-scope ARG is a buildx cache
# miss for everything after it — declared at the top it made the apt/npm ci
# layers uncacheable across commits (run 30983842725: predecessor cache
# imported, 0 layers CACHED).
ARG LEAF_SOURCE_SHA=unknown

ENV HARNESS_PORT=8150 \
    LEAF_RUNTIME_ENV=production \
    LEAF_AUTHORED_EXECUTION=0 \
    LEAF_INSTANT_EXECUTION_ENABLED=0 \
    LEAF_AGENT_MOCK=0 \
    LEAF_HARNESS_AUTHORING_MODE=disabled \
    LEAF_HARNESS_SESSION_STORE=file \
    LEAF_REPO_ROOT=/app \
    LEAF_TENANT_FIXTURE=/app/test/fixtures/tenant-repo \
    LEAF_TENANTS_DIR=/data/tenants \
    LEAF_GRANTS_DIR=/data/grants \
    LEAF_SOURCE_SHA=${LEAF_SOURCE_SHA} \
    BROKER_URL=http://broker:8140 \
    NODE_ENV=production

EXPOSE 8150

# GET /health -> 200 (needs no grant).
HEALTHCHECK --interval=10s --timeout=5s --start-period=15s --retries=6 \
  CMD node -e "require('http').get('http://localhost:8150/health',r=>process.exit(r.statusCode===200?0:1)).on('error',()=>process.exit(1))"

USER 10002:10002

CMD ["/app/scripts/start-harness.sh"]
