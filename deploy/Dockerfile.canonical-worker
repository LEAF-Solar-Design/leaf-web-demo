# syntax=docker/dockerfile:1.7
#
# Leaf Platform canonical PostgreSQL worker. This is a separate process from
# the API and owns the lease/heartbeat/terminal transition loop for the first
# real solver adapter. The solver source is supplied as a named build context so
# it stays owned by its repository and its exact bytes are hashed at runtime.
FROM python:3.12-slim AS canonical-worker

WORKDIR /app

COPY platform/requirements.txt /app/platform/requirements.txt
RUN pip install --no-cache-dir -r /app/platform/requirements.txt

COPY server/ /app/server/
COPY platform/ /app/platform/
COPY scripts/canonical-container-smoke.py /app/scripts/canonical-container-smoke.py
COPY deploy/autofill-solver-sources.json /app/deploy/autofill-solver-sources.json
COPY --from=autofill_solver . /opt/leaf/autofill-solver/

# --- Runtime proof that the shipped scripts survived the build. ---------------
# Same guard, same reasoning, and the same EXACT spelling as deploy/Dockerfile.app
# (read the long comment there for why each part is load-bearing; it is not
# repeated in four files). In short: EXEC FORM so a `SHELL ["/bin/true"]` above
# it cannot turn the guard into a no-op, and `-s` as well as `-f` because `-f`
# alone accepts an EMPTY file, so a truncation ships a smoke script that exits 0
# and proves nothing. Pinned by
# test_every_image_asserts_its_shipped_scripts_at_build_time.
#
# POSITION, which differs from the app's and is the reason this sits here rather
# than at the end. This file declares its per-commit ARGs near the TOP, and
# scripts/test_build_platform_images_workflow.py requires every RUN below them to
# CONSUME one through a real shell expansion. An exec-form RUN never invokes a
# shell, so it can never consume, so it can never legally sit below the ARG in
# this file. Above the ARG is therefore the only position available, and it is
# still below the only instruction that writes /app/scripts.
#
# WHAT THAT COSTS, stated rather than glossed: two ARG-consuming RUNs follow this
# guard, so unlike the app's they are not covered by "nothing may run after the
# guard". Both are pinned BYTE-EXACT in that test instead, so a third RUN here,
# or an edit to either of these two, fails rather than shipping unchecked.
#
# USER IS DECLARED HERE, above the guard, and that placement is the whole point
# of `test -r`. A guard that runs as ROOT proves nothing about what uid 65532
# can reach: root reads a 0600 file happily, and a `chmod 0700` on the
# directory leaves every `test -f` passing while the operator's containerised
# smoke cannot open its own script. Running the guard AS 65532 tests the real
# uid, gid and directory traversal, and no spelling of a mode change above it
# can evade that, because nothing about the spelling is being read. Two earlier
# attempts to pay for this by scanning command text were defeated (by
# `install --mode=`, and by `c''hmod`); Docker's own USER needs neither su nor
# setpriv, and a numeric uid needs no /etc/passwd entry.
USER 65532:65532

RUN ["/bin/sh", "-c", "test -f /app/scripts/canonical-container-smoke.py && test -s /app/scripts/canonical-container-smoke.py && test -r /app/scripts/canonical-container-smoke.py"]

# Back to root for the two ARG-consuming RUNs below, which the per-commit ARG
# contract forces beneath the guard. The second writes .leaf-source-revision
# into root-owned /opt/leaf and /app, so it cannot run as 65532. USER returns
# to 65532 before CMD, and the test asserts the uid in effect AT THE GUARD
# equals the uid the container ends up running as -- so this round trip cannot
# quietly leave the guard proving something about the wrong identity.
USER root

# Declared below every non-consuming instruction, deliberately: LEAF_SOURCE_SHA
# is a new commit sha on every build, and a changed in-scope ARG is a buildx
# cache miss for everything after it — declared at the top it made the pip
# layer uncacheable across commits (run 30983842725: predecessor cache
# imported, 1 layer CACHED).
ARG AUTOFILL_SOLVER_REVISION
ARG LEAF_SOURCE_SHA

# The named context may be a mutable local checkout. Do not trust the revision
# argument by itself. Hash the copied Python source, require the checked-in
# commit-to-digest mapping, then seal that verified identity into the image.
RUN PYTHONPATH=/app/server python -c "from pathlib import Path; from solver_adapters.autofill import attest_source; attest_source(Path('/opt/leaf/autofill-solver'), '${AUTOFILL_SOLVER_REVISION}', Path('/app/deploy/autofill-solver-sources.json'))"

WORKDIR /app/server

RUN python -c \
      "import re,sys; value=sys.argv[1]; raise SystemExit(0 if re.fullmatch(r'[0-9a-f]{40}', value) else 'AUTOFILL_SOLVER_REVISION must be an exact lowercase 40-character commit')" \
      "$AUTOFILL_SOLVER_REVISION" \
    && python -c \
      "import re,sys; value=sys.argv[1]; raise SystemExit(0 if re.fullmatch(r'[0-9a-f]{40}', value) else 'LEAF_SOURCE_SHA must be an exact lowercase 40-character commit')" \
      "$LEAF_SOURCE_SHA" \
    && printf '%s\n' "$AUTOFILL_SOLVER_REVISION" \
      > /opt/leaf/autofill-solver/.leaf-source-revision \
    && printf '%s\n' "$LEAF_SOURCE_SHA" > /app/.leaf-source-revision

ENV AUTOFILL_SOLVER_ROOT=/opt/leaf/autofill-solver \
    AUTOFILL_SOLVER_REVISION=${AUTOFILL_SOLVER_REVISION} \
    LEAF_SOURCE_SHA=${LEAF_SOURCE_SHA} \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

# A live process is insufficient: require the worker's recent PostgreSQL
# heartbeat so a broken DB or source mount reports unhealthy.
HEALTHCHECK --interval=10s --timeout=5s --start-period=15s --retries=3 \
  CMD python -c "import platform_link; raise SystemExit(0 if platform_link.canonical_worker_health('string-autofill-opt') else 1)"

USER 65532:65532

CMD ["python", "canonical_worker.py", "--poll-seconds", "1"]
