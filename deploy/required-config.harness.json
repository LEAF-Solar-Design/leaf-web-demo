{
  "schemaVersion": 1,
  "container": "leaf-platform-harness",
  "required": {
    "environment": [
      "BROKER_URL",
      "LEAF_APP_URL",
      "LEAF_GRANTS_DIR",
      "LEAF_HARNESS_AUTH",
      "LEAF_HARNESS_AUTHORING_MODE",
      "LEAF_HARNESS_SESSION_STORE",
      "LEAF_AUTHORED_EXECUTION",
      "LEAF_AGENT_MOCK",
      "LEAF_RUNTIME_ENV",
      "LEAF_SANDBOX",
      "LEAF_TENANTS_DIR",
      "LEAF_TENANT_FIXTURE",
      "LEAF_TENANT_GIT_DIR",
      "LEAF_TENANT_MCP_BROKER_URL"
    ],
    "mountPaths": [
      "/data/grants",
      "/data/tenant-git",
      "/data/tenants"
    ],
    "secrets": [
      "LEAF_APP_DISPATCH_SECRET",
      "LEAF_BROKER_SECRET",
      "LEAF_HARNESS_SECRET"
    ]
  }
}
