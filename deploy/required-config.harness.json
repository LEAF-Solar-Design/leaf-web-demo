{
  "schemaVersion": 1,
  "container": "leaf-platform-harness",
  "required": {
    "environment": [
      "BROKER_URL",
      "LEAF_GRANTS_DIR",
      "LEAF_HARNESS_AUTH",
      "LEAF_SANDBOX",
      "LEAF_TENANTS_DIR",
      "LEAF_TENANT_FIXTURE"
    ],
    "secrets": [
      "LEAF_BROKER_SECRET",
      "LEAF_HARNESS_SECRET"
    ],
    "mountPaths": [
      "/data/grants",
      "/data/tenants"
    ]
  }
}
