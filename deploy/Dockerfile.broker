# syntax=docker/dockerfile:1
#
# Leaf platform — APS credential BROKER process (CONTRACT-ADDENDUM §8).
#
# THE security chokepoint: the ONLY process that imports da/client.py and the
# ONLY one that may read the APS credential. Tenant-facing code calls it over
# HTTP (POST /broker/run) and never holds the secret. Also the attribution
# ledger + per-tenant kill-switch + in-process egress allowlist.
#
# Listens on :8140.  The APS credential is provided at RUNTIME via a mounted
# file referenced by APS_CRED (default ~/.aps/credentials.json) — it is NEVER
# baked into this image and is only read on live (APS_LIVE=1) runs.
#
# --- Node helper stage (opt-in LEAF_SANDBOX=e2b-microvm tier, F2) -----------
# Installs ONLY the e2b SDK into its own throwaway node_modules. This must
# NEVER become `npm install` against harness/package.json — that manifest
# pulls in the Anthropic agent SDK, which must not enter the broker image
# (broker stays server+da only, per the header comment above).
FROM node:20-slim AS e2bdeps
WORKDIR /helper
RUN npm init -y && npm install e2b@^2.35.0

FROM python:3.12-slim AS broker

WORKDIR /app

# --- Python deps: server + da + the opt-in PostgreSQL authority runtime. -------
# Legacy mode never imports platform. PostgreSQL mode loads it lazily, so the
# image must contain psycopg and psycopg-pool before that flag can be enabled.
# No database credential is baked into this image.
COPY server/requirements.txt /app/server/requirements.txt
COPY da/requirements.txt     /app/da/requirements.txt
COPY platform/requirements.txt /app/platform/requirements.txt
RUN pip install --no-cache-dir \
      -r /app/server/requirements.txt \
      -r /app/da/requirements.txt \
      -r /app/platform/requirements.txt

# --- Node runtime for the E2B micro-VM tool-exec helper (LEAF_SANDBOX=e2b-microvm,
#     F2 opt-in tier; the shipped default remains the LEAF_SANDBOX=e2b subprocess
#     tier and needs none of this). libstdc++6 satisfies the copied node binary's
#     dynamic linking on this debian-slim base — node:20-slim is debian-slim and
#     ships it, python:3.12-slim does not by default.
# git is REQUIRED here too, not only in the app: executing a PUBLISHED tenant tool
# runs broker.py -> tool_loader.resolve_local_file -> tenant_paths ->
# customization_service.effective_catalog_dir, which calls _git_blob on every
# resolution even when the shared worktree already exists. Without git the broker
# raises FileNotFoundError and an authored tool that stages and publishes fine is
# still unusable. python:3.12-slim ships no git.
# HTTPS mirrors (see Dockerfile.app / Dockerfile.harness: the build runner's
# VPC has no port-80 egress).
# This whole block sits ABOVE the per-commit source COPYs deliberately:
# nothing in it reads the source tree (the one COPY from the build context,
# e2b-tool-exec.mjs, keys its cache on that file's content alone), and below
# them the apt + node layers re-ran on every merge (run 31006198764: apt 6.1s
# + node 0.7s rebuilt after cache-busting source COPYs).
#
# Security posture: apply Debian security updates at build time so the image
# never ships base-layer CVEs the distro has already fixed (the Trivy
# cve-harvest gate blocks HIGH/CRITICAL with a released fix; libexpat1
# CVE-2026-56408 turned staging auto-deploys off for every merge until the
# harness picked up this exact contract, run 33465506870).
#
# The producer resolves both signed trixie channel documents and passes their
# exact SHA256 values as build arguments. They are cache-key inputs to this
# RUN and members of the signed surface fingerprint, so a Debian channel
# update both invalidates this apt layer and refuses signed reuse of the
# pre-update image. The files apt downloaded must match before any package is
# upgraded; a missing, malformed, stale, or substituted value fails the build
# closed. Same contract, same spelling as deploy/Dockerfile.harness (bookworm
# there, trixie here — python:3.12-slim is Debian 13).
ARG TRIXIE_DEBIAN_SECURITY_INRELEASE_SHA256
ARG TRIXIE_DEBIAN_UPDATES_INRELEASE_SHA256

RUN printf '%s\n' "$TRIXIE_DEBIAN_SECURITY_INRELEASE_SHA256" \
      | grep -Eq '^[0-9a-f]{64}$' \
 && printf '%s\n' "$TRIXIE_DEBIAN_UPDATES_INRELEASE_SHA256" \
      | grep -Eq '^[0-9a-f]{64}$' \
 && find /etc/apt -type f \( -name '*.list' -o -name '*.sources' \) \
    -exec sed -i \
      -e 's|http://deb.debian.org|https://deb.debian.org|g' \
      -e 's|http://security.debian.org|https://security.debian.org|g' {} + \
 && apt-get update \
 && printf '%s  %s\n' "$TRIXIE_DEBIAN_SECURITY_INRELEASE_SHA256" \
      /var/lib/apt/lists/deb.debian.org_debian-security_dists_trixie-security_InRelease \
      | sha256sum -c - \
 && printf '%s  %s\n' "$TRIXIE_DEBIAN_UPDATES_INRELEASE_SHA256" \
      /var/lib/apt/lists/deb.debian.org_debian_dists_trixie-updates_InRelease \
      | sha256sum -c - \
 && apt-get upgrade -y \
 && apt-get install -y --no-install-recommends libstdc++6 git \
      && rm -rf /var/lib/apt/lists/*
COPY --from=node:20-slim /usr/local/bin/node /usr/local/bin/node
COPY --from=e2bdeps /helper/node_modules /app/harness/node_modules
COPY harness/scripts/e2b-tool-exec.mjs /app/harness/scripts/e2b-tool-exec.mjs
# NOTE: import "e2b" from /app/harness/scripts/*.mjs resolves node_modules by
# walking UP from the script dir, hence node_modules landing at
# /app/harness/node_modules (sibling of scripts/, not scripts/node_modules).
# E2B_API_KEY is NEVER baked here — like APS_CRED above, it is runtime-injected
# (Secrets Manager) and only read when LEAF_SANDBOX=e2b-microvm is actually used.
# F11 (not yet applied to this file): once a non-root `leaf` uid is added before
# CMD, /usr/local/bin/node and /app/harness/node_modules must stay world/uid
# readable so that uid can still exec the helper.
ENV LEAF_E2B_HELPER=/app/harness/scripts/e2b-tool-exec.mjs

# --- Broker source + the siblings it resolves via PROJECT_ROOT = /app --------
# (broker.py: SERVER_DIR.parent; inserts /app + /app/server on sys.path, then
# imports da/, engine tools, data/rooftop_demo.intake.json for the mock path).
# These change on every merge, so they stay below every source-independent
# layer above.
COPY server/  /app/server/
COPY da/      /app/da/
COPY engine/  /app/engine/
COPY platform/ /app/platform/
COPY contract/ /app/contract/
COPY data/    /app/data/

# Run from the server workdir (broker.py caches stdlib `platform`/`queue` before
# the PROJECT_ROOT sys.path insert, so the local da/queue.py never shadows them).
WORKDIR /app/server

# F11: the broker must not run as root. Runtime EFS mounts replace these
# directories in ECS, while the local directories keep compose/dev runs writable.
RUN useradd --system --uid 10001 --user-group --home /home/leaf --create-home leaf \
  && mkdir -p /data/state /data/drawings \
  && chown -R 10001:10001 /data /home/leaf

# --- Runtime proof that the shipped scripts survived the build. ---------------
# Same guard, same reasoning, and the same EXACT spelling as deploy/Dockerfile.app
# (read the long comment there for why each part is load-bearing; it is not
# repeated in four files). In short: EXEC FORM so a `SHELL ["/bin/true"]` above
# it cannot turn the guard into a no-op, and `-s` as well as `-f` because `-f`
# alone accepts an EMPTY file. LEAF_E2B_HELPER above points the broker at this
# exact path, so a deletion or truncation of it currently surfaces only when an
# operator first runs a LEAF_SANDBOX=e2b-microvm tool. Pinned by
# test_every_image_asserts_its_shipped_scripts_at_build_time.
#
# Below every instruction that writes /app/harness/scripts, and ABOVE the
# per-commit ARG: a RUN below that ARG re-executes on every merge, which
# scripts/test_build_platform_images_workflow.py forbids outright, and an
# exec-form RUN can never satisfy its consumption rule (it invokes no shell).
#
# USER IS DECLARED HERE, above the guard, and that placement is the whole point
# of `test -r`. A guard that runs as ROOT proves nothing about what uid 10001
# can reach: root reads a 0600 file happily, and a `chmod 0700` on the
# directory leaves every `test -f` passing while the broker cannot open the
# helper. Running the guard AS 10001 tests the real uid, gid and directory
# traversal, and no spelling of a mode change above it can evade that, because
# nothing about the spelling is being read. Two earlier attempts to pay for
# this by scanning command text were defeated (by `install --mode=`, and by
# `c''hmod`); Docker's own USER needs neither su nor setpriv.
USER 10001:10001

RUN ["/bin/sh", "-c", "test -f /app/harness/scripts/e2b-tool-exec.mjs && test -s /app/harness/scripts/e2b-tool-exec.mjs && test -r /app/harness/scripts/e2b-tool-exec.mjs"]

# Declared below every non-consuming instruction, deliberately: this value is a
# new commit sha on every build, and a changed in-scope ARG is a buildx cache
# miss for everything after it — declared at the top it made the pip/apt layers
# uncacheable across commits (run 30983842725: predecessor cache imported,
# 0 layers CACHED).
ARG LEAF_SOURCE_SHA=unknown

ENV APS_LIVE=0 \
    BROKER_PORT=8140 \
    LEAF_CALLBACK_REPLAY_STORE=legacy \
    LEAF_BROKER_STORE=legacy \
    LEAF_DRAWING_STORE=legacy \
    LEAF_JOBS_STORE=legacy \
    LEAF_SOURCE_SHA=${LEAF_SOURCE_SHA} \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

EXPOSE 8140

# GET /broker/health -> 200.
HEALTHCHECK --interval=10s --timeout=5s --start-period=15s --retries=6 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8140/broker/health', timeout=4)" || exit 1

# NOTE: the runtime USER is NOT declared here any more. It moved ABOVE the
# survival guard so the guard runs as that uid; USER is stateful, so it is
# still in effect for the container. Nothing between there and here needs root.
# The uid is deliberately NOT spelled out in this comment: a test pins it as a
# substring of this file, and a comment carrying the literal would satisfy that
# pin on its own while the real instruction said something else.

# uvicorn --host 0.0.0.0 is REQUIRED here: `python broker.py` binds 127.0.0.1
# (loopback only) and would be unreachable from the app/harness containers.
CMD ["uvicorn", "broker:app", "--host", "0.0.0.0", "--port", "8140"]
