# syntax=docker/dockerfile:1.7
#
# Staging-only warm instant execution image. It contains the control plane,
# reconciler, executor runtime, and their declared Python dependencies only.
FROM python:3.12-slim

ARG LEAF_SOURCE_SHA

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && python -c "import re,sys; value=sys.argv[1]; raise SystemExit(0 if re.fullmatch(r'[0-9a-f]{40}', value) else 'LEAF_SOURCE_SHA must be an exact lowercase 40-character commit')" "$LEAF_SOURCE_SHA" \
    && addgroup --system --gid 65532 leaf \
    && adduser --system --uid 65532 --ingroup leaf --home /nonexistent --no-create-home leaf \
    && mkdir -p /run/leaf/secrets \
    && chown 65532:65532 /run/leaf/secrets \
    && chmod 0700 /run/leaf/secrets

COPY executor/control_plane/requirements.txt /tmp/control-plane-requirements.txt
COPY executor/runtime/requirements.txt /tmp/runtime-requirements.txt
RUN pip install --no-cache-dir \
      -r /tmp/control-plane-requirements.txt \
      -r /tmp/runtime-requirements.txt \
    && rm -f /tmp/control-plane-requirements.txt /tmp/runtime-requirements.txt

WORKDIR /opt/leaf

# Copy runtime package code, not repository-wide source, tests, or host state.
COPY --chown=65532:65532 executor/bootstrap.py /opt/leaf/executor/bootstrap.py
COPY --chown=65532:65532 executor/control_plane/*.py /opt/leaf/executor/control_plane/
COPY --chown=65532:65532 executor/control_plane/migrations/ /opt/leaf/executor/control_plane/migrations/
COPY --chown=65532:65532 executor/runtime/*.py /opt/leaf/executor/runtime/
COPY --chown=65532:65532 executor/registry/*.py /opt/leaf/executor/registry/
COPY --chown=65532:65532 executor/contracts/*.py /opt/leaf/executor/contracts/
COPY --chown=65532:65532 executor/contracts/schemas/ /opt/leaf/executor/contracts/schemas/

LABEL org.opencontainers.image.revision=$LEAF_SOURCE_SHA \
      org.opencontainers.image.title=leaf-platform-instant-execution

ENV LEAF_SOURCE_SHA=${LEAF_SOURCE_SHA} \
    HOME=/tmp \
    PYTHONPATH=/opt/leaf \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    TMPDIR=/tmp \
    XDG_CACHE_HOME=/tmp

USER 65532:65532

# Mount /tmp as tmpfs when launching with --read-only. The default is the
# control-plane WSGI process. The same image also runs the reconciler or warm
# executor through the explicit commands documented in deploy/README.md.
CMD ["gunicorn", "--bind", "0.0.0.0:8080", "--workers", "2", "--worker-tmp-dir", "/tmp", "--access-logfile", "-", "--error-logfile", "-", "executor.control_plane.production:create_wsgi_application()"]
