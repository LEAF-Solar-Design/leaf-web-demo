# syntax=docker/dockerfile:1
#
# Leaf platform — WEB frontend (Vite + React + three.js), served static by nginx.
#
# LIVE build: VITE_MOCK=0 (default) bakes the app to hit the backend; the browser
# calls VITE_API_BASE directly. The deploy default is same-origin, while local
# docker-compose passes the app's published host port as a build arg.
# The header Mock toggle still lets a viewer flip to client-side data at runtime.

# ---- engine stage: compile the CAD engine wasm (card F-3) -------------------
# Builds the rev-pinned, unmodified MPL-2.0 engine crate (vendor pin +
# license posture: docs/CAD-ENGINE-LICENSE-REVIEW.md) to a browser wasm the
# editing surface's worker loads at /engine/*. Reproducible in-image: no
# machine-local artifact is ever committed. Cargo fetch is network-bound and
# rev-pinned, so the layer caches on the vendor dir's content.
FROM rust:1-slim AS engine
RUN cargo install wasm-pack --locked
WORKDIR /engine-src
COPY vendor/acadrust-worker/ /engine-src/
# --out-name engine: the artifacts are BORN crate-name-free, and — load-
# bearing — the wasm binary's import module key is baked at build time as
# ./<out-name>_bg.js. A post-hoc file rename cannot change that key, which is
# how the first staged engine died in the browser: glue rewritten to import
# './engine_bg.js', binary still demanding './acadrust_worker_bg.js'
# (WebAssembly.instantiate: "Import #0 ... module is not an object").
RUN RUSTFLAGS='--cfg getrandom_backend="wasm_js"' \
    wasm-pack build --release --target web . --out-dir pkg-web --out-name engine

# ---- build stage: vite build (env baked at BUILD time) ----------------------
FROM node:22-slim AS build
WORKDIR /web

ARG VITE_API_BASE=
ARG VITE_MOCK=0
ARG VITE_AUTH0_DOMAIN=leafautomation.us.auth0.com
ARG VITE_AUTH0_CLIENT_ID=zkJjr0ZFtcyQjyJ8e4zdkdgzoMaVWt5O
ARG VITE_AUTH0_AUDIENCE=https://api.leafdesign.ai
ARG VITE_LIFECYCLE_UI=1
# ios_surface flip: ON (1), operator-directed 2026-08-30 (#823) -- the
# consume-only iOS readiness surface renders; its live status still needs the
# paired config-rail LEAF_IOS_SURFACE_ENABLED=1 on the app. Rollback = 0 here
# AND in build-platform-images.yml's two web-build env blocks together.
# leaf-plan envelope: ios_surface. Commit-stable, so it stays above npm ci.
ARG VITE_IOS_SURFACE=1
# cad_edit flip: ON (1), operator-directed 2026-08-30 (#823). One shared web
# image serves both staging and production, so this is the documented
# all-environments enable. Read as the string '1' everywhere
# (web/src/cadedit/flag.js and the isCadEditEnabled env fallback in
# web/src/cad/engineWorker.js). Rollback = 0 here AND in
# build-platform-images.yml's two web-build env blocks AND the
# check_web_container_config.mjs pin, together.
# Commit-stable, so it stays above npm ci.
ARG VITE_CAD_EDIT=1
ENV VITE_API_BASE=${VITE_API_BASE} \
    VITE_MOCK=${VITE_MOCK} \
    VITE_AUTH0_DOMAIN=${VITE_AUTH0_DOMAIN} \
    VITE_AUTH0_CLIENT_ID=${VITE_AUTH0_CLIENT_ID} \
    VITE_AUTH0_AUDIENCE=${VITE_AUTH0_AUDIENCE} \
    VITE_LIFECYCLE_UI=${VITE_LIFECYCLE_UI} \
    VITE_IOS_SURFACE=${VITE_IOS_SURFACE} \
    VITE_CAD_EDIT=${VITE_CAD_EDIT}

COPY web/package.json web/package-lock.json /web/
RUN npm ci

# Declared below npm ci, deliberately: this value is a new commit sha on every
# build, and a changed in-scope ARG/ENV is a buildx cache miss for everything
# after it — declared above npm ci it made the dependency layer uncacheable
# across commits (run 30983842725: predecessor cache imported, 0 layers CACHED).
# The VITE_* args above are commit-stable, so they may stay at the top.
ARG LEAF_SOURCE_SHA=unknown
ENV LEAF_SOURCE_SHA=${LEAF_SOURCE_SHA}

COPY web/ /web/
# The engine stage's wasm-pack output + the stage script land the runtime
# engine at dist/engine/{engine.js,engine_bg.wasm} with a PROVENANCE.json
# (crate rev + sha256s). Staged AFTER the vite build so the fence-relevant
# source tree never carries the binary.
COPY vendor/acadrust-worker/Cargo.toml /vendor/acadrust-worker/Cargo.toml
# The worker entry itself must exist at the resolved spawn path or the vite
# build cannot bundle the worker chunk (it fails closed, as run 33455169029
# proved) — the shim carries no crate-name strings, so the fence stays clean.
COPY vendor/acadrust-worker/worker-browser.mjs /vendor/acadrust-worker/worker-browser.mjs
COPY --from=engine /engine-src/pkg-web /vendor/acadrust-worker/pkg-web
COPY scripts/stage_cad_engine.mjs /scripts/stage_cad_engine.mjs
RUN npm run build && \
    node /scripts/stage_cad_engine.mjs && \
    test -f /web/dist/engine/engine_bg.wasm && \
    test -n "$(find /web/dist/assets -name 'worker-browser*.js' -print -quit)" && \
    printf '{"ok":true,"service":"leaf-platform-web","component":"frontend","source_sha":"%s"}\n' \
      "$LEAF_SOURCE_SHA" > /web/dist/health.json

# ---- serve stage: nginx on :8080 --------------------------------------------
FROM nginx:alpine AS web

# The release producer hashes the exact Alpine main APKINDEX exposed by this
# nginx base and passes it here. The digest is both a cache-key input and a
# fail-closed check on the bytes apk uses, so a repository update rebuilds this
# layer even when nginx:alpine still resolves to the same base digest.
# Targeted upgrades only (libexpat, libuuid), each with a version floor at or
# above the Trivy-named fix, so a stale index fails the build instead of
# shipping the vulnerable package (libuuid 2.42.1-r0: seven HIGH CVEs, 2026-09-05).
ARG WEB_ALPINE_MAIN_APKINDEX_SHA256
RUN printf '%s\n' "$WEB_ALPINE_MAIN_APKINDEX_SHA256" \
      | grep -Eq '^[0-9a-f]{64}$' \
  && main_repo="$(awk '/\/main\/?$/ { print }' /etc/apk/repositories)" \
  && [ "$(printf '%s\n' "$main_repo" | sed '/^$/d' | wc -l)" -eq 1 ] \
  && printf '%s\n' "$main_repo" \
      | grep -Eq '^https://dl-cdn\.alpinelinux\.org/alpine/v[0-9]+\.[0-9]+/main/?$' \
  && repositories_file=/tmp/web-alpine-main.repositories \
  && printf '%s\n' "$main_repo" > "$repositories_file" \
  && rm -rf /var/cache/apk/* \
  && apk --repositories-file "$repositories_file" update \
  && set -- /var/cache/apk/APKINDEX.*.tar.gz \
  && [ "$#" -eq 1 ] \
  && printf '%s  %s\n' "$WEB_ALPINE_MAIN_APKINDEX_SHA256" "$1" \
      | sha256sum -c - \
  && apk --repositories-file "$repositories_file" upgrade libexpat libuuid \
  && installed_version="$(apk list --installed libexpat \
      | sed -n 's/^libexpat-\([^ ]*\).*/\1/p')" \
  && [ -n "$installed_version" ] \
  && [ "$(apk version -t "$installed_version" 2.8.4-r0)" != '<' ] \
  && libuuid_version="$(apk list --installed libuuid \
      | sed -n 's/^libuuid-\([^ ]*\).*/\1/p')" \
  && [ -n "$libuuid_version" ] \
  && [ "$(apk version -t "$libuuid_version" 2.42.3-r0)" != '<' ] \
  && rm -f "$repositories_file" \
  && rm -rf /var/cache/apk/*

COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /web/dist /usr/share/nginx/html
# Runtime flags: rewritten at container boot from the task-definition env
# (LEAF_ONE_SHELL_ENABLED; fail-closed to '0'). nginx:alpine's entrypoint
# runs every /docker-entrypoint.d/*.sh before nginx starts.
COPY deploy/write-runtime-flags.sh /docker-entrypoint.d/40-runtime-flags.sh
RUN chmod +x /docker-entrypoint.d/40-runtime-flags.sh
EXPOSE 8080

# GET / -> 200 (busybox wget; nginx:alpine has no curl). Use the IPv4 literal:
# nginx listens on 0.0.0.0:8080 (IPv4) and busybox wget resolves `localhost` to
# ::1 (IPv6) with no fallback -> a false "unhealthy".
HEALTHCHECK --interval=10s --timeout=5s --start-period=5s --retries=6 \
  CMD wget -q -O /dev/null http://127.0.0.1:8080/ || exit 1

# nginx:alpine's default entrypoint runs nginx in the foreground.
