# syntax=docker/dockerfile:1
#
# Leaf platform — WEB frontend (Vite + React + three.js), served static by nginx.
#
# LIVE build: VITE_MOCK=0 (default) bakes the app to hit the backend; the browser
# calls VITE_API_BASE directly. The deploy default is same-origin, while local
# docker-compose passes the app's published host port as a build arg.
# The header Mock toggle still lets a viewer flip to client-side data at runtime.

# ---- build stage: vite build (env baked at BUILD time) ----------------------
FROM node:22-slim AS build
WORKDIR /web

ARG VITE_API_BASE=
ARG VITE_MOCK=0
ARG VITE_AUTH0_DOMAIN=leafautomation.us.auth0.com
ARG VITE_AUTH0_CLIENT_ID=zkJjr0ZFtcyQjyJ8e4zdkdgzoMaVWt5O
ARG VITE_AUTH0_AUDIENCE=https://api.leafdesign.ai
ARG VITE_LIFECYCLE_UI=1
# ios_surface flip: OFF (0) by default -- the consume-only iOS readiness surface
# stays dormant until the operator's Apple/TestFlight leg lands and the flip is
# authorized. Set to 1 (here AND in build-platform-images.yml's web-build env
# blocks) plus config-rail LEAF_IOS_SURFACE_ENABLED=1 to take it live.
# leaf-plan envelope: ios_surface. Commit-stable, so it stays above npm ci.
ARG VITE_IOS_SURFACE=1
# cad_edit flip: OFF (0) by default -- the CAD editing surface stays dormant.
# Plumbed here only so the flag is SETTABLE at build time; nothing enables it.
# Read as the string '1' everywhere (web/src/cadedit/flag.js and the
# isCadEditEnabled env fallback in web/src/cad/engineWorker.js). Set to 1 (here
# AND in build-platform-images.yml's two web-build env blocks) to take it live.
# Commit-stable, so it stays above npm ci.
ARG VITE_CAD_EDIT=1
ENV VITE_API_BASE=${VITE_API_BASE} \
    VITE_MOCK=${VITE_MOCK} \
    VITE_AUTH0_DOMAIN=${VITE_AUTH0_DOMAIN} \
    VITE_AUTH0_CLIENT_ID=${VITE_AUTH0_CLIENT_ID} \
    VITE_AUTH0_AUDIENCE=${VITE_AUTH0_AUDIENCE} \
    VITE_LIFECYCLE_UI=${VITE_LIFECYCLE_UI} \
    VITE_IOS_SURFACE=${VITE_IOS_SURFACE} \
    VITE_CAD_EDIT=${VITE_CAD_EDIT}

COPY web/package.json web/package-lock.json /web/
RUN npm ci

# Declared below npm ci, deliberately: this value is a new commit sha on every
# build, and a changed in-scope ARG/ENV is a buildx cache miss for everything
# after it — declared above npm ci it made the dependency layer uncacheable
# across commits (run 30983842725: predecessor cache imported, 0 layers CACHED).
# The VITE_* args above are commit-stable, so they may stay at the top.
ARG LEAF_SOURCE_SHA=unknown
ENV LEAF_SOURCE_SHA=${LEAF_SOURCE_SHA}

COPY web/ /web/
RUN npm run build && \
    printf '{"ok":true,"service":"leaf-platform-web","component":"frontend","source_sha":"%s"}\n' \
      "$LEAF_SOURCE_SHA" > /web/dist/health.json

# ---- serve stage: nginx on :8080 --------------------------------------------
FROM nginx:alpine AS web
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /web/dist /usr/share/nginx/html
EXPOSE 8080

# GET / -> 200 (busybox wget; nginx:alpine has no curl). Use the IPv4 literal:
# nginx listens on 0.0.0.0:8080 (IPv4) and busybox wget resolves `localhost` to
# ::1 (IPv6) with no fallback -> a false "unhealthy".
HEALTHCHECK --interval=10s --timeout=5s --start-period=5s --retries=6 \
  CMD wget -q -O /dev/null http://127.0.0.1:8080/ || exit 1

# nginx:alpine's default entrypoint runs nginx in the foreground.
